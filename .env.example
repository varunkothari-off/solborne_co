# =============================================================================
# Solborne & Co. — Environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`
# (it is already gitignored). This template holds variable NAMES and
# placeholders only — no real secrets.
#
# Server-side secrets (SERVICE_ROLE, *_SECRET, API keys) must only ever be
# read on the server — never expose them to the browser / client bundle.
# PUBLIC_-prefixed variables are exposed to the browser by Astro — only
# publishable values belong there.
# =============================================================================


# --- Supabase -------------------------------------------------------------
# Auth + database: login, stored diagnostic answers, bookings, experts.
# Get from: https://supabase.com/dashboard → your project → Project Settings
#   → "Data API" (URL + anon/publishable key) and "API Keys" (service role).
SUPABASE_URL=https://your-project-ref.supabase.co       # Project URL (safe to expose)
SUPABASE_ANON_KEY=your-anon-publishable-key             # Publishable key (browser-safe, RLS-gated)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key         # SECRET — server only, bypasses RLS. Never ship to client.
# Browser copies for the /book/ sign-in island (same values as above two):
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key


# --- Internal API ----------------------------------------------------------
# Shared secret for internal-only endpoints (/api/calls/*, /api/outreach/*,
# /api/dashboard/*) and the DB's internal RPCs. Generate with:
#   openssl rand -hex 32
# Its sha256 hash must be stored in Postgres (see docs/wiring-checklist.md).
INTERNAL_API_SECRET=generate-a-long-random-hex-string

# Discovery-call order amount in paise (INR). Founder sets the real price
# before go-live; kept out of the public site per the pricing gate.
DISCOVERY_CALL_AMOUNT_PAISE=99900


# --- Stripe (THE payment rail) --------------------------------------------
# Payments for the $1,497 screening package (USD-first). The server confirms
# via the signature-verified /api/webhooks/stripe (checkout.session.completed)
# before anything is trusted as "paid" — the success redirect is never proof.
# Get from: https://dashboard.stripe.com → Developers → API keys, and
#   Developers → Webhooks (endpoint /api/webhooks/stripe) for the signing
#   secret. IMPORTANT: use TEST-mode keys (sk_test_ / pk_test_) for dev.
# While these are placeholders the app uses src/lib/stubs/stripe.ts; the
# non-empty whsec_ placeholder lets the stub loopback simulator sign/verify.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxx                 # SECRET — server only
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxx            # Browser-safe (Checkout)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx               # SECRET — verifies /api/webhooks/stripe


# --- ElevenLabs -----------------------------------------------------------
# Voice AI: the walk's speech-to-text (Scribe) and the outbound screening
# call. The screening call is placed only after the package is paid.
# Get from: https://elevenlabs.io → Profile → API Keys (key); Conversational
#   AI → Agents (agent ID) and Phone Numbers (phone number ID) for outbound.
# While these are placeholders, the app uses src/lib/stubs/elevenlabs.ts.
ELEVENLABS_API_KEY=your-elevenlabs-api-key              # SECRET — server only
ELEVENLABS_AGENT_ID=your-conversational-agent-id        # The discovery-call agent
ELEVENLABS_PHONE_NUMBER_ID=your-outbound-phone-number-id # Registered outbound caller ID


# --- Razorpay (REMOVED — INR track, deferred) -----------------------------
# The INR storefront (₹9,900 package) is a later, geo-gated phase per Phase-0
# sequencing. Razorpay was swapped out for Stripe (USD-first). If/when the INR
# track returns, add a Razorpay provider behind the same payment seam.
# RAZORPAY_KEY_ID= / RAZORPAY_KEY_SECRET= / RAZORPAY_WEBHOOK_SECRET=


# --- Anthropic / Claude API -------------------------------------------------
# Powers the walk's generated "right questions" and the preliminary report
# (with web research). Get from: console.anthropic.com → Settings → API Keys.
# While this is a placeholder, the app uses the labelled LLM stub.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxx                # SECRET — server only


# --- NOT REFERENCED IN REPO — confirm before adding -----------------------
# Sarvam AI — not referenced anywhere in the repo or docs.
# SARVAM_API_KEY=your-sarvam-api-subscription-key        # SECRET — server only

# --- Walk flow ---------------------------------------------------------------
# Claude model for question-generation + reports.
LLM_MODEL=claude-sonnet-5
# Login buttons shown on /login/ — comma-separated Supabase provider ids,
# enabled as you configure each provider (email works out of the box).
PUBLIC_AUTH_PROVIDERS=email

# --- Screening package (the paywall) -----------------------------------------
# Phase-0 fair pricing: $1,497 flat USD-first (149700 cents). One payment =
# AI screening calls + expert screening calls + the final audit report.
SCREENING_PACKAGE_AMOUNT_MINOR=149700
SCREENING_PACKAGE_CURRENCY=USD
