---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ConfidenceBar from '../components/ConfidenceBar.astro';
import { services, type Service } from '../data/services';
import { caseStudies } from '../data/case-studies';
import { site } from '../data/site';

const pageTitle = `${site.name} — ${site.tagline}`;
/* DRAFT COPY */
const pageDescription =
  'Independent AI advisory for small firms and growing practices. Rigorous, human-checked answers about AI in plain language, at prices within reach.';

/** Home-page service highlights, pulled from the catalog in display order. */
const highlightSlugs = ['diagnostic', 'opportunity-audit', 'module-build'];
const highlights = highlightSlugs
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is Service => s !== undefined);

/* DRAFT COPY */
const steps = [
  {
    num: '01',
    name: 'Ask',
    text: 'Eight plain questions about how work actually moves through your firm, and an honest first read — including where AI is not worth your attention.',
  },
  {
    num: '02',
    name: 'Answer',
    text: 'Rigorous work in plain language. No jargon-mystique, no deck built to impress rather than inform.',
  },
  {
    num: '03',
    name: 'Verify',
    text: 'Every paid deliverable is checked by a human before it reaches you. Confidence gets a number, not a shrug — you see how sure we are, and why.',
  },
  {
    num: '04',
    name: 'Hand over',
    text: 'We hand you the reins: the roadmap, the keys, the training to run it yourself. The decision — and the credit — stay with you.',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- DRAFT COPY -->
  <PageIntro eyebrow="Independent AI advisory" title="Clear judgment about AI, within reach.">
    <p>
      Solborne &amp; Co. answers the AI questions that used to require an expensive
      consultant — rigorously and in plain language, with every paid deliverable
      checked by a human before it reaches you. Built for small firms, solo practices,
      and growing brands priced out of the big consultancies.
    </p>
  </PageIntro>

  <div class="wrap">
    <div class="cta-row">
      <Button href="/contact/">Start with the free diagnostic</Button>
      <Button href="/services/" variant="ghost">See services</Button>
    </div>
  </div>

  <Section label="What we do" title="The questions that used to require an expensive consultant">
    <!-- DRAFT COPY -->
    <div class="service-grid">
      {
        highlights.map((s) => (
          <article class:list={['card', { flagship: s.flagship }]}>
            <h3>{s.name}</h3>
            <p class="price">
              {s.price}
              <span class="price-note">{s.priceNote}</span>
            </p>
            <p class="summary">{s.summary}</p>
          </article>
        ))
      }
    </div>
    <!-- DRAFT COPY -->
    <p class="more"><a href="/services/">All services &rarr;</a></p>
  </Section>

  <Section label="How we work" title="Your guide, not your stand-in">
    <!-- DRAFT COPY -->
    <p class="section-lead">
      We don't take the wheel of your business. We help you read the road, then hand
      you the reins — the same care at every price.
    </p>
    <div class="how-grid">
      <!-- DRAFT COPY -->
      <ol class="steps" role="list">
        {
          steps.map((step) => (
            <li class="step">
              <span class="step-num" aria-hidden="true">{step.num}</span>
              <div>
                <h3>{step.name}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="demo">
        <!-- DRAFT COPY -->
        <ConfidenceBar
          question="Should we use AI in our intake process?"
          answer="Short answer: yes, for triage — not for the final decision."
          confidence={78}
          note="The gap is your data volume; we'd revisit above 10k tickets/mo."
        />
        <!-- DRAFT COPY -->
        <p class="demo-note">Every answer we hand over carries its number.</p>
      </div>
    </div>
    <!-- DRAFT COPY -->
    <p class="more"><a href="/approach/">Our approach &rarr;</a></p>
  </Section>

  <Section label="Recent work" title="Recent engagements">
    <!-- DRAFT COPY -->
    <div class="case-grid">
      {
        caseStudies.map((cs) => (
          <article class="case-card">
            <p class="tag">In preparation</p>
            <h3>
              <a href={`/case-studies/${cs.slug}/`}>{cs.name}</a>
            </h3>
            <p class="teaser">{cs.teaser}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <section class="cta-band" aria-label="Start a conversation">
    <div class="wrap">
      <div class="stage">
        <!-- DRAFT COPY -->
        <p class="pull">
          If AI is on your mind and the big firms are out of reach, start with the
          read that costs nothing.
        </p>
        <div class="cta-row cta-row--stage">
          <Button href="/contact/">Start with the free diagnostic</Button>
          <Button href="/services/" variant="ghost">See services</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Masthead CTA row ---- */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-sm);
  }

  .wrap > .cta-row {
    margin: -1.25rem 0 4.25rem;
  }

  /* ---- What we do: service highlights ---- */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .card {
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.5rem 1.625rem;
  }

  /* The single permitted amber surface — the flagship card only. */
  .card.flagship {
    background: var(--color-bearing-wash);
  }

  .card h3 {
    margin-bottom: 0.625rem;
  }

  .price {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono-medium);
    font-size: var(--text-body-sm);
    color: var(--color-steel);
    margin-bottom: 0.875rem;
  }

  .price-note {
    display: inline-block;
    margin-left: var(--space-2xs);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
  }

  .summary {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  .more {
    margin-top: var(--space-md);
    font-size: var(--text-body-sm);
  }

  /* ---- How we work ---- */
  .section-lead {
    max-width: var(--width-intro);
    color: var(--color-body);
    margin-bottom: var(--space-lg);
  }

  .how-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .steps {
    list-style: none;
    display: grid;
    gap: var(--space-md);
  }

  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm);
  }

  .step-num {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono-medium);
    font-size: var(--text-caption);
    color: var(--color-steel);
    padding-top: 0.25rem;
  }

  .step h3 {
    margin-bottom: 0.375rem;
  }

  .step p {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  .demo-note {
    margin-top: var(--space-xs);
    font-size: var(--text-caption);
    color: var(--color-stone);
  }

  /* ---- Recent work ---- */
  .case-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .case-card {
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.5rem 1.625rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: 0.875rem;
  }

  .case-card h3 {
    margin-bottom: 0.625rem;
  }

  .case-card h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .case-card h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-steel);
    text-underline-offset: 3px;
  }

  .teaser {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  /* ---- Final CTA band ---- */
  .cta-band {
    padding: var(--space-lg) 0 var(--space-2xl);
  }

  .stage {
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-stage);
    padding: clamp(2.5rem, 2rem + 2vw, 3.75rem) var(--space-lg);
    text-align: center;
  }

  .pull {
    font-family: var(--font-display);
    font-weight: var(--weight-display);
    font-size: var(--text-h2);
    line-height: var(--leading-heading);
    color: var(--color-ink);
    max-width: 24ch;
    margin: 0 auto;
  }

  .cta-row--stage {
    margin-top: var(--space-lg);
  }

  /* ---- Responsive ---- */
  @media (max-width: 860px) {
    .how-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 760px) {
    .service-grid,
    .case-grid {
      grid-template-columns: 1fr;
    }

    .stage {
      padding-inline: var(--space-md);
    }
  }
</style>
