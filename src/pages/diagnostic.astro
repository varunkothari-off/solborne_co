---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import { roadmap, evidenceTiers } from '../data/roadmap';

/**
 * Free diagnostic — category-first, branching, fully rule-based (no backend,
 * no scoring service, no human review). This keeps it inside the architecture
 * spec's hard constraint: the free tier stays automated, because "the moment a
 * human touches it, the free-tier economics no longer apply."
 *
 * Flow: entry fork → domain multi-select → shared questions asked ONCE
 * (role, tools — merged across every selected domain) → branch-specific
 * questions asked once each (pain per domain, deal type) → cross-cutting
 * questions → contact details (this is a lead-capture tool) → a deterministic
 * read-out that reflects the visitor's own words back and shows real,
 * tier-labelled benchmarks.
 *
 * The question list is computed as the UNION of what the selected domains
 * need — nothing is ever asked twice, and the progress indicator counts the
 * resolved path. Lead details are captured before the read-out; see the
 * LEAD CAPTURE INTEGRATION POINT in the script (front-end only for now,
 * mirroring the contact form).
 */

// ---- Build a slug → item lookup the client can render from ----
const itemsBySlug: Record<
  string,
  {
    name: string;
    slug: string;
    blurb: string;
    category: string;
    claim: string;
    tier: number;
    source: string;
  }
> = {};
for (const category of roadmap) {
  for (const item of category.items) {
    if (!item.slug || !item.detail) continue;
    itemsBySlug[item.slug] = {
      name: item.name,
      slug: item.slug,
      blurb: item.blurb,
      category: category.name,
      claim: item.detail.benefit.claim,
      tier: item.detail.benefit.tier,
      source: item.detail.benefit.source,
    };
  }
}

// ---- Domain config: each pain-point option maps to specific item slugs.
// Weights: the pain point is the heaviest signal (primary 4 / secondary 2);
// a "tools/role" answer can add a small boost. Cross-cutting answers change
// framing only, never the match.
//
// `context` and `tools` are the SHARED questions: when several domains are
// selected, the client merges their options and asks each question once. ----
const domains = {
  legal: {
    label: 'Legal, compliance, or contract work',
    context: {
      q: 'Which best describes you?',
      options: [
        { label: 'Solo or small firm', value: 'a solo or small firm' },
        { label: 'In-house counsel', value: 'in-house counsel' },
        { label: 'A non-legal operator', value: 'a non-legal operator' },
      ],
    },
    tools: {
      q: 'What do you use for this today?',
      options: [
        { label: 'Westlaw / LexisNexis', value: 'Westlaw or LexisNexis' },
        { label: 'A CLM (Ironclad, Juro…)', value: 'a contract-management platform' },
        { label: 'Neither — mostly by hand', value: 'no dedicated tooling' },
      ],
    },
    pain: {
      q: 'What is actually eating your time?',
      options: [
        { label: 'A citation-backed read on a legal question', slugs: ['legal-research'] },
        { label: 'Clause-by-clause contract review against a playbook', slugs: ['contract-review'] },
        { label: 'A first-draft contract from a term sheet', slugs: ['draft-a-contract'] },
        { label: 'Complaint summary, defenses, and deposition prep', slugs: ['litigation-prep'] },
        { label: 'A standing watch on regulatory change', slugs: ['compliance-monitor'] },
        { label: 'Estimating billable hours to scope or quote a matter', slugs: ['billable-hours'] },
      ],
    },
    defaults: ['legal-research', 'contract-review'],
  },
  deal: {
    label: 'Deal, investment, or lending work',
    context: {
      q: 'Which best describes your seat?',
      options: [
        { label: 'PE / independent sponsor', value: 'private equity or an independent sponsor' },
        { label: 'VC / angel', value: 'venture or angel investing' },
        { label: 'Corporate development', value: 'corporate development' },
        { label: 'Lending / credit', value: 'lending or credit' },
      ],
    },
    tools: {
      q: 'What data tools do you have?',
      options: [
        { label: 'Bloomberg / FactSet / Capital IQ', value: 'a terminal (Bloomberg, FactSet, or Capital IQ)' },
        { label: 'Excel only', value: 'Excel only' },
        { label: 'Neither', value: 'neither a terminal nor a modelling stack' },
      ],
    },
    pain: {
      q: 'What is actually eating your time?',
      options: [
        { label: 'A full company due-diligence review', slugs: ['due-diligence', 'customer-cube-review'] },
        { label: 'A market map / landscape', slugs: ['market-map', 'startup-market-map'] },
        { label: 'A ranked investor target list', slugs: ['investor-sourcing'] },
        { label: 'A trading-comps table', slugs: ['company-comps'] },
        { label: 'A three-statement / valuation model', slugs: ['three-statement-model', 'debt-capacity-analysis'] },
        { label: 'A credit-committee memo', slugs: ['credit-memo', 'loan-structuring-analysis'] },
        { label: 'A first read of a CIM', slugs: ['cim-review'] },
        { label: 'CRE underwriting / an IC memo', slugs: ['property-acquisition-underwriting', 'real-estate-ic-memo'] },
        { label: 'Scoring a pitch deck', slugs: ['pitch-deck-screen'] },
        { label: 'Equity research / earnings work', slugs: ['earnings-brief', 'equity-research-council', 'key-driver-analysis'] },
      ],
    },
    dealType: {
      q: 'Which asset class, mainly?',
      options: [
        { label: 'Commercial real estate', boost: ['property-acquisition-underwriting', 'real-estate-ic-memo', 'property-analysis'] },
        { label: 'Corporate credit / lending', boost: ['credit-memo', 'loan-structuring-analysis', 'debt-capacity-analysis'] },
        { label: 'Public equities', boost: ['company-comps', 'earnings-brief', 'equity-research-council', 'key-driver-analysis'] },
        { label: 'Private equity / venture', boost: ['due-diligence', 'cim-review', 'startup-market-map', 'sourcing-screen'] },
      ],
    },
    defaults: ['due-diligence', 'market-map', 'company-comps'],
  },
  sales: {
    label: 'Sales & business development',
    context: {
      q: 'Which best describes you?',
      options: [
        { label: 'SDR / BDR', value: 'an SDR or BDR' },
        { label: 'Account executive', value: 'an account executive' },
        { label: 'Sales leader', value: 'a sales leader' },
        { label: 'Founder-led sales', value: 'running founder-led sales' },
      ],
    },
    tools: {
      q: 'What do you use today?',
      options: [
        { label: 'ZoomInfo / Sales Navigator', value: 'ZoomInfo or Sales Navigator' },
        { label: 'A CRM only', value: 'a CRM only' },
        { label: 'Neither', value: 'no dedicated sales-intel tooling' },
      ],
    },
    pain: {
      q: 'What is actually eating your time?',
      options: [
        { label: 'Personalized outreach copy', slugs: ['outreach-message'] },
        { label: 'Research-driven campaigns, run at scale', slugs: ['account-outreach'] },
        { label: 'A demo script tailored to an account', slugs: ['customer-demo'] },
        { label: 'Account & prospect research for call prep', slugs: ['account-profiles', 'prospect-research', 'sales-prep'] },
      ],
    },
    defaults: ['account-profiles', 'outreach-message'],
  },
  marketing: {
    label: 'Marketing & brand',
    context: {
      q: 'Which best describes you?',
      options: [
        { label: 'In-house marketer', value: 'an in-house marketer' },
        { label: 'Agency', value: 'an agency' },
        { label: 'Founder / owner', value: 'a founder or owner' },
      ],
    },
    tools: {
      q: 'What do you use today?',
      options: [
        { label: 'Semrush / Ahrefs', value: 'Semrush or Ahrefs' },
        { label: 'Social / listening tools', value: 'social or listening tools' },
        { label: 'None in particular', value: 'no dedicated marketing tooling' },
      ],
    },
    pain: {
      q: 'What is actually eating your time?',
      options: [
        { label: 'SEO / keyword research', slugs: ['seo-keyword-research'] },
        { label: 'Storefront / listing optimization', slugs: ['store-optimizer'] },
        { label: 'A competitor-creative reference deck', slugs: ['brand-inspiration'] },
        { label: 'Newsletters / social posts in my voice', slugs: ['newsletter-post-creator'] },
        { label: 'Product images across variants', slugs: ['product-photos'] },
        { label: 'Event brief, page, invites, RSVP', slugs: ['event-prep'] },
        { label: 'Brand sentiment / reputation', slugs: ['brand-reputation'] },
        { label: 'An account profile for a sales call', slugs: ['sales-prep'] },
      ],
    },
    defaults: ['seo-keyword-research', 'newsletter-post-creator'],
  },
  hiring: {
    label: 'Hiring & people',
    context: {
      q: 'Which best describes you?',
      options: [
        { label: 'In-house talent acquisition', value: 'in-house talent acquisition' },
        { label: 'Founder / hiring manager', value: 'a founder or hiring manager' },
        { label: 'Staffing / RPO', value: 'a staffing or RPO provider' },
      ],
    },
    tools: {
      q: 'What do you use today?',
      options: [
        { label: 'LinkedIn Recruiter / ATS', value: 'LinkedIn Recruiter or an ATS' },
        { label: 'Job boards only', value: 'job boards only' },
        { label: 'Nothing formal', value: 'no dedicated sourcing tooling' },
      ],
    },
    pain: {
      q: 'What is actually eating your time?',
      options: [
        { label: 'A one-off rubric and shortlist', slugs: ['candidate-sourcing'] },
        { label: 'An ongoing, replenishing pipeline', slugs: ['autonomous-candidate-sourcing'] },
      ],
    },
    defaults: ['candidate-sourcing'],
  },
  general: {
    label: 'General research, competitive intel, or admin / document work',
    context: {
      q: 'Which best describes you?',
      options: [
        { label: 'Operator / ops', value: 'an operator' },
        { label: 'Consultant', value: 'a consultant' },
        { label: 'Analyst / researcher', value: 'an analyst or researcher' },
        { label: 'Founder', value: 'a founder' },
      ],
    },
    pain: {
      q: 'What is actually eating your time?',
      options: [
        { label: 'A deep market read', slugs: ['market-research'] },
        { label: 'Ongoing competitive intelligence', slugs: ['competitive-intelligence'] },
        { label: 'Monitoring a topic or entity', slugs: ['intelligence-monitor'] },
        { label: 'A marketing audit of my site', slugs: ['website-audit'] },
        { label: 'A product teardown', slugs: ['product-teardown'] },
        { label: 'Software-category adoption trends', slugs: ['software-adoption'] },
        { label: 'A clinical evidence brief', slugs: ['evidence-brief', 'medical-evidence-council'] },
        { label: 'A final fact-check / annotation pass', slugs: ['final-pass'] },
        { label: 'Summarizing a long document', slugs: ['document-summary'] },
        { label: 'Building a slide deck', slugs: ['slide-creation'] },
        { label: 'Building a website', slugs: ['website-builder'] },
        { label: 'Improving an AI prompt', slugs: ['prompt-refinement'] },
        { label: 'Polishing a message', slugs: ['message-polish'] },
        { label: 'Removing an image background', slugs: ['background-removal'] },
        { label: 'Converting a file', slugs: ['filetype-converter'] },
      ],
    },
    defaults: ['market-research', 'document-summary'],
  },
  money: {
    label: 'Money & budgeting',
    tools: {
      q: 'What do you use today?',
      options: [
        { label: 'Rocket Money / Monarch / YNAB', value: 'a budgeting app' },
        { label: 'A spreadsheet', value: 'a spreadsheet' },
        { label: 'Nothing in particular', value: 'no dedicated tool' },
      ],
    },
    pain: {
      q: 'What is actually on your mind?',
      options: [
        { label: 'A daily read on my money', slugs: ['daily-finance-digest'] },
        { label: 'Where my spending is heading', slugs: ['run-rate-dashboard'] },
        { label: 'Whether I stay positive before payday', slugs: ['cash-flow-forecast'] },
        { label: 'Forgotten subscriptions to cancel', slugs: ['subscription-cleanup'] },
        { label: 'Monthly spending + full net worth', slugs: ['spending-net-worth-review'] },
        { label: 'The best card for each purchase', slugs: ['credit-card-optimizer'] },
      ],
    },
    defaults: ['spending-net-worth-review', 'cash-flow-forecast'],
  },
  career: {
    label: 'Job search & career',
    context: {
      q: 'Where are you?',
      options: [
        { label: 'Student / new grad', value: 'a student or new grad' },
        { label: 'Career changer', value: 'a career changer' },
        { label: 'Mid-career', value: 'mid-career' },
        { label: 'Returning to work', value: 'returning to work' },
      ],
    },
    pain: {
      q: 'What is actually on your mind?',
      options: [
        { label: 'Which roles fit me, and my skill gaps', slugs: ['career-explorer'] },
        { label: 'Company-specific interview prep', slugs: ['interview-prep'] },
        { label: 'An ATS-ready resume + cover letter', slugs: ['resume-cover-letter'] },
        { label: 'Matched jobs + outreach notes', slugs: ['job-finder'] },
        { label: 'Scholarships / fellowships', slugs: ['scholarship-finder'] },
      ],
    },
    defaults: ['career-explorer', 'resume-cover-letter'],
  },
  health: {
    label: 'Health & wellness',
    pain: {
      q: 'What is actually on your mind?',
      options: [
        { label: 'A full overview of my health', slugs: ['health-review'] },
        { label: 'A meal plan aligned to my labs', slugs: ['nutrition-planner'] },
        { label: 'Understanding my lab results', slugs: ['lab-results-interpreter'] },
        { label: 'A workout + recovery plan', slugs: ['fitness-sleep-coach'] },
      ],
    },
    defaults: ['health-review'],
  },
} as const;

const paths = {
  business: {
    label: 'My work',
    blurb: 'Something professional — for your firm, team, or practice.',
    domains: ['legal', 'deal', 'sales', 'marketing', 'hiring', 'general'],
    scaleLabel: 'How big is your team or firm?',
    scaleOptions: ['Solo / under 20', '20–200', '200+'],
  },
  personal: {
    label: 'My own situation',
    blurb: 'Something personal — for you or your household.',
    domains: ['money', 'career', 'health'],
    scaleLabel: 'How complex is your situation?',
    scaleOptions: ['Straightforward', 'Moderate', 'Complex'],
  },
} as const;

const dxData = { itemsBySlug, domains, paths, tiers: evidenceTiers };

const pageTitle = 'Free diagnostic — Solborne & Co.';
const pageDescription =
  'A short run of plain questions about where your time actually goes — the diagnostic adapts as you answer. You get an honest, automated first read on which workflows fit, with real benchmarks and how solid each number is.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro eyebrow="Free diagnostic" title="Where would this actually help you?">
    <p>
      A few plain questions about where your time actually goes. You get an
      honest first read on which of our workflows fit — with real benchmarks
      and a note on how solid each number is.
    </p>
    <p>
      It’s automated, which is what makes it free — and it adapts as you
      answer, so you only see the questions that apply to you. A couple of
      minutes, no call attached.
    </p>
  </PageIntro>

  <Section label="The diagnostic">
    <div id="dx" class="dx" data-dx>
      <noscript>
        <p class="dx-noscript">
          The diagnostic needs JavaScript to run. You can also just
          <a href="/contact/">tell us your situation directly</a> — same result,
          a real person reads it.
        </p>
      </noscript>
    </div>
  </Section>

  <script type="application/json" id="dx-config" set:html={JSON.stringify(dxData)}></script>

  <script>
    type Item = {
      name: string; slug: string; blurb: string; category: string;
      claim: string; tier: number; source: string;
    };
    type Option = { label: string; value?: string; slugs?: string[]; boost?: string[] };
    type Question = { q: string; options: Option[] };
    type Domain = {
      label: string; context?: Question; tools?: Question;
      pain: Question; dealType?: Question; defaults: string[];
    };
    type Tier = { label: string; note: string };
    type Data = {
      itemsBySlug: Record<string, Item>;
      domains: Record<string, Domain>;
      paths: Record<string, { label: string; blurb: string; domains: string[]; scaleLabel: string; scaleOptions: string[] }>;
      tiers: Record<string, Tier>;
    };

    const el = document.querySelector<HTMLElement>('[data-dx]');
    const cfgEl = document.getElementById('dx-config');
    if (el && cfgEl) {
      const data: Data = JSON.parse(cfgEl.textContent || '{}');

      // ---- State ----
      const state: {
        path: string | null;
        domains: string[];
        /** Shared role answer — asked once, whatever the domain mix. */
        role: string | null;
        roleValue: string | null;
        /** Shared tools answer — one multi-select over the merged options. */
        tools: string[];
        /** Branch-specific answers, keyed by domain: pain, dealType. */
        answers: Record<string, Record<string, string>>;
        frequency: string | null;
        scale: string | null;
        lead: { name: string; email: string; firm: string };
        /** Server-side lead id once POST /api/leads succeeds. */
        leadId: string | null;
        leadSaveFailed: boolean;
      } = {
        path: null, domains: [], role: null, roleValue: null, tools: [],
        answers: {}, frequency: null, scale: null,
        lead: { name: '', email: '', firm: '' },
        leadId: null, leadSaveFailed: false,
      };

      const esc = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      // ---- Shared-question merging (the de-duplication core) ----
      // Union of a shared question's options across every selected domain,
      // de-duplicated by label, in domain-selection order.
      function unionOptions(key: 'context' | 'tools'): Option[] {
        const seen = new Set<string>();
        const out: Option[] = [];
        for (const d of state.domains) {
          const q = data.domains[d][key];
          if (!q) continue;
          for (const o of q.options) {
            if (!seen.has(o.label)) {
              seen.add(o.label);
              out.push(o);
            }
          }
        }
        return out;
      }

      const NONE_RE = /^(neither|none|nothing)/i;

      // The role question ("which best describes you?") — asked exactly once.
      function roleQuestion(): Question | null {
        const contributors = state.domains.filter((d) => data.domains[d].context);
        if (!contributors.length) return null;
        const q =
          contributors.length === 1
            ? data.domains[contributors[0]].context!.q
            : 'Which best describes you?';
        return { q, options: unionOptions('context') };
      }

      // The tools question — asked exactly once, as a pick-any multi-select.
      // With several domains merged, the per-domain "neither/none" variants
      // collapse into one canonical "None of these".
      function toolsQuestion(): Question | null {
        const contributors = state.domains.filter((d) => data.domains[d].tools);
        if (!contributors.length) return null;
        let options = unionOptions('tools');
        let q = 'What do you use for this work today?';
        if (contributors.length === 1) {
          q = data.domains[contributors[0]].tools!.q;
        } else {
          options = options.filter((o) => !NONE_RE.test(o.label));
          options = options.concat([{ label: 'None of these', value: '' }]);
        }
        return { q, options };
      }

      // Build the ordered list of steps from current selections: the union of
      // required questions, each exactly once. Shared questions (role, tools)
      // come right after the domain pick; branch-specific questions follow,
      // once per selected domain; cross-cutting and contact close the flow.
      function buildSteps(): string[] {
        const steps = ['fork', 'domains'];
        if (roleQuestion()) steps.push('role');
        if (toolsQuestion()) steps.push('tools');
        for (const d of state.domains) {
          steps.push(`${d}:pain`);
          if (data.domains[d].dealType) steps.push(`${d}:dealType`);
        }
        steps.push('frequency', 'scale', 'contact', 'readout');
        return steps;
      }

      let stepIndex = 0;

      /** One-shot: CSS selector to focus after the next render instead of the
          heading — used by the multi-select toggles so keyboard focus stays on
          the option just toggled rather than jumping back to the question. */
      let refocus: string | null = null;

      const cssAttr = (v: string) => v.replace(/\\/g, '\\\\').replace(/"/g, '\\"');

      function go(delta: number) {
        stepIndex = Math.max(0, stepIndex + delta);
        render();
      }

      // Bar + step count, computed from the resolved path. The read-out is
      // the destination, not a counted step.
      function progress(steps: string[]) {
        const total = steps.length - 1;
        const onReadout = stepIndex >= total;
        const pct = Math.round((Math.min(stepIndex, total) / total) * 100);
        const label = onReadout
          ? 'Your read-out'
          : `Step <strong>${stepIndex + 1}</strong> of <strong>${total}</strong>`;
        return (
          `<p class="dx-count">${label}</p>` +
          `<div class="dx-progress" role="progressbar" aria-label="Diagnostic progress" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100"><span style="width:${pct}%"></span></div>`
        );
      }

      function shell(steps: string[], inner: string, opts: { back?: boolean } = {}) {
        const back = opts.back
          ? `<button type="button" class="dx-back" data-back>&larr; Back</button>`
          : '';
        el!.innerHTML =
          progress(steps) + `<div class="dx-card">${inner}</div>` +
          `<div class="dx-nav">${back}</div>`;
        el!.querySelector('[data-back]')?.addEventListener('click', () => go(-1));
        el!.querySelectorAll<HTMLButtonElement>('[data-choose]').forEach((b) => {
          b.addEventListener('click', () => onChoose(b));
        });
        el!.querySelector<HTMLButtonElement>('[data-next]')?.addEventListener('click', onNext);
        // Focus the heading for screen-reader continuity — unless a toggle
        // asked to keep focus where the user was (multi-select re-renders).
        const target = refocus ? el!.querySelector<HTMLElement>(refocus) : null;
        refocus = null;
        (target ?? el!.querySelector<HTMLElement>('.dx-q'))?.focus();
      }

      function onChoose(btn: HTMLButtonElement) {
        const { kind } = btn.dataset;
        if (kind === 'path') {
          // Re-clicking the path already chosen (e.g. after backing up to
          // review it) just moves forward — it must not wipe the answers.
          if (state.path === btn.dataset.value) {
            stepIndex = 1;
            render();
            return;
          }
          state.path = btn.dataset.value!;
          state.domains = [];
          state.answers = {};
          state.role = null;
          state.roleValue = null;
          state.tools = [];
          stepIndex = 1;
          render();
        } else if (kind === 'domain') {
          const d = btn.dataset.value!;
          const i = state.domains.indexOf(d);
          if (i >= 0) state.domains.splice(i, 1);
          else if (state.domains.length < 3) state.domains.push(d);
          // The merged role/tools option sets depend on the domain mix, so a
          // change here resets them; branch answers for dropped domains go too.
          state.role = null;
          state.roleValue = null;
          state.tools = [];
          for (const key of Object.keys(state.answers)) {
            if (!state.domains.includes(key)) delete state.answers[key];
          }
          refocus = `[data-kind="domain"][data-value="${cssAttr(d)}"]`;
          render(); // re-render multi-select to reflect toggle
        } else if (kind === 'role') {
          state.role = btn.dataset.value!;
          const opt = roleQuestion()?.options.find((o) => o.label === state.role);
          state.roleValue = opt?.value ?? state.role;
          go(1);
        } else if (kind === 'tool') {
          const label = btn.dataset.value!;
          const i = state.tools.indexOf(label);
          if (i >= 0) {
            state.tools.splice(i, 1);
          } else if (NONE_RE.test(label)) {
            // "None of these" (or a domain's own "Neither") clears real picks…
            state.tools = [label];
          } else {
            // …and picking a real tool clears any none-variant.
            state.tools = state.tools.filter((t) => !NONE_RE.test(t));
            state.tools.push(label);
          }
          refocus = `[data-kind="tool"][data-value="${cssAttr(label)}"]`;
          render(); // re-render multi-select to reflect toggle
        } else if (kind === 'answer') {
          const [dom, key] = btn.dataset.target!.split(':');
          state.answers[dom] = state.answers[dom] || {};
          state.answers[dom][key] = btn.dataset.value!;
          go(1);
        } else if (kind === 'cross') {
          (state as any)[btn.dataset.key!] = btn.dataset.value!;
          go(1);
        }
      }

      async function onNext() {
        const steps = buildSteps();
        const step = steps[stepIndex];
        if (step === 'domains') {
          if (state.domains.length === 0) return;
          go(1);
        } else if (step === 'tools') {
          if (state.tools.length === 0) return;
          go(1);
        } else if (step === 'contact') {
          const nameInput = el!.querySelector<HTMLInputElement>('#dx-lead-name');
          const emailInput = el!.querySelector<HTMLInputElement>('#dx-lead-email');
          const firmInput = el!.querySelector<HTMLInputElement>('#dx-lead-firm');
          const error = el!.querySelector<HTMLElement>('[data-error]');
          const name = nameInput?.value.trim() ?? '';
          const emailOk = !!emailInput && emailInput.value.trim() !== '' && emailInput.checkValidity();
          if (!name || !emailOk) {
            if (error) error.hidden = false;
            (!name ? nameInput : emailInput)?.focus();
            return;
          }
          state.lead = {
            name,
            email: emailInput!.value.trim(),
            firm: firmInput?.value.trim() ?? '',
          };

          // ============================================================
          // LEAD CAPTURE — WIRED: the payload is stored server-side via
          // POST /api/leads (Supabase-backed). The returned lead id powers
          // the "Book the discovery call" CTA on the read-out. A failure
          // never blocks the read-out — the visitor still gets their result.
          // ============================================================
          const payload = {
            lead: state.lead,
            path: state.path,
            domains: state.domains,
            role: state.role,
            tools: state.tools,
            answers: state.answers,
            frequency: state.frequency,
            scale: state.scale,
            matches: score().ranked,
          };

          const nextBtn = el!.querySelector<HTMLButtonElement>('[data-next]');
          if (nextBtn) {
            nextBtn.disabled = true;
            nextBtn.textContent = 'Saving…';
          }
          state.leadId = null;
          state.leadSaveFailed = false;
          try {
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), 8000);
            const res = await fetch('/api/leads', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify(payload),
              signal: controller.signal,
            });
            clearTimeout(timer);
            if (res.ok) {
              const data = await res.json();
              state.leadId = typeof data.lead_id === 'string' ? data.lead_id : null;
            }
            state.leadSaveFailed = !state.leadId;
          } catch {
            state.leadSaveFailed = true;
          }

          go(1);
        }
      }

      // ---- Scoring ----
      function score() {
        const weights: Record<string, number> = {};
        const add = (slug: string, w: number) => {
          if (data.itemsBySlug[slug]) weights[slug] = (weights[slug] || 0) + w;
        };
        const picked: { domain: string; painLabel: string }[] = [];

        for (const d of state.domains) {
          const dom = data.domains[d];
          const ans = state.answers[d] || {};
          // Pain point — the heaviest signal.
          const painOpt = dom.pain.options.find((o) => o.label === ans.pain);
          if (painOpt && painOpt.slugs) {
            painOpt.slugs.forEach((s, i) => add(s, i === 0 ? 4 : 2));
            picked.push({ domain: d, painLabel: painOpt.label });
          }
          // Deal-type boost.
          if (dom.dealType && ans.dealType) {
            const dt = dom.dealType.options.find((o) => o.label === ans.dealType);
            dt?.boost?.forEach((s) => add(s, 1));
          }
          // Fallback: if this domain produced no pain match, seed its defaults.
          if (!painOpt) dom.defaults.forEach((s, i) => add(s, i === 0 ? 3 : 2));
        }

        let ranked = Object.entries(weights)
          .sort((a, b) => b[1] - a[1])
          .map(([slug]) => slug);

        // Absolute fallback: nothing scored → seed defaults of chosen domains.
        if (ranked.length === 0) {
          const seed = new Set<string>();
          state.domains.forEach((d) => data.domains[d].defaults.forEach((s) => seed.add(s)));
          ranked = [...seed];
        }
        return { ranked: ranked.slice(0, 6), picked };
      }

      // ---- Renderers ----
      function optionGrid(opts: Option[], attrs: (o: Option) => string, selected?: (o: Option) => boolean) {
        return `<div class="dx-options">${opts
          .map(
            (o) =>
              `<button type="button" class="dx-option${selected && selected(o) ? ' is-selected' : ''}" ${attrs(o)}>${esc(o.label)}</button>`
          )
          .join('')}</div>`;
      }

      function render() {
        const steps = buildSteps();
        if (stepIndex >= steps.length) stepIndex = steps.length - 1;
        const step = steps[stepIndex];

        if (step === 'fork') {
          const inner =
            `<h3 class="dx-q" tabindex="-1">Are you here about your work, or your own situation?</h3>` +
            `<div class="dx-options dx-options--wide">` +
            Object.entries(data.paths)
              .map(
                ([k, p]) =>
                  `<button type="button" class="dx-option dx-option--block" data-choose data-kind="path" data-value="${k}"><span class="dx-option-title">${esc(p.label)}</span><span class="dx-option-sub">${esc(p.blurb)}</span></button>`
              )
              .join('') +
            `</div>`;
          shell(steps, inner);
          return;
        }

        if (step === 'domains') {
          const p = data.paths[state.path!];
          const inner =
            `<h3 class="dx-q" tabindex="-1">Which of these is closest? Pick up to three.</h3>` +
            `<p class="dx-hint">You’ve chosen ${state.domains.length} of 3. Shared questions are only ever asked once, whatever you pick.</p>` +
            optionGrid(
              p.domains.map((d) => ({ label: data.domains[d].label, value: d } as Option)),
              (o) => `data-choose data-kind="domain" data-value="${(o as any).value}"`,
              (o) => state.domains.includes((o as any).value)
            ) +
            `<button type="button" class="dx-primary" data-next ${state.domains.length === 0 ? 'disabled' : ''}>Continue &rarr;</button>`;
          shell(steps, inner, { back: true });
          return;
        }

        if (step === 'role') {
          const q = roleQuestion()!;
          const inner =
            `<h3 class="dx-q" tabindex="-1">${esc(q.q)}</h3>` +
            optionGrid(
              q.options,
              (o) => `data-choose data-kind="role" data-value="${esc(o.label)}"`,
              (o) => state.role === o.label
            );
          shell(steps, inner, { back: true });
          return;
        }

        if (step === 'tools') {
          const q = toolsQuestion()!;
          const inner =
            `<h3 class="dx-q" tabindex="-1">${esc(q.q)}</h3>` +
            `<p class="dx-hint">Pick any that apply.</p>` +
            optionGrid(
              q.options,
              (o) => `data-choose data-kind="tool" data-value="${esc(o.label)}"`,
              (o) => state.tools.includes(o.label)
            ) +
            `<button type="button" class="dx-primary" data-next ${state.tools.length === 0 ? 'disabled' : ''}>Continue &rarr;</button>`;
          shell(steps, inner, { back: true });
          return;
        }

        if (step === 'frequency') {
          const inner =
            `<h3 class="dx-q" tabindex="-1">Is this a one-time need, or does it come up regularly?</h3>` +
            optionGrid(
              [
                { label: 'A one-time need' },
                { label: 'It comes up regularly (weekly / monthly)' },
              ],
              (o) => `data-choose data-kind="cross" data-key="frequency" data-value="${esc(o.label)}"`,
              (o) => state.frequency === o.label
            );
          shell(steps, inner, { back: true });
          return;
        }

        if (step === 'scale') {
          const p = data.paths[state.path!];
          const inner =
            `<h3 class="dx-q" tabindex="-1">${esc(p.scaleLabel)}</h3>` +
            optionGrid(
              p.scaleOptions.map((s) => ({ label: s })),
              (o) => `data-choose data-kind="cross" data-key="scale" data-value="${esc(o.label)}"`,
              (o) => state.scale === o.label
            );
          shell(steps, inner, { back: true });
          return;
        }

        if (step === 'contact') {
          const inner =
            `<p class="dx-eyebrow">Last step</p>` +
            `<h3 class="dx-q" tabindex="-1">Who should we address the read-out to?</h3>` +
            `<p class="dx-hint">Your read-out appears right on the next screen. Your details let a person follow up with the human-reviewed version — no list, no drip sequence.</p>` +
            `<div class="dx-fields">` +
            `<div class="dx-field"><label for="dx-lead-name">Name</label><input id="dx-lead-name" type="text" autocomplete="name" required value="${esc(state.lead.name)}"></div>` +
            `<div class="dx-field"><label for="dx-lead-email">Email</label><input id="dx-lead-email" type="email" autocomplete="email" required value="${esc(state.lead.email)}"></div>` +
            `<div class="dx-field"><label for="dx-lead-firm">Firm / organization <span class="dx-optional">(optional)</span></label><input id="dx-lead-firm" type="text" autocomplete="organization" value="${esc(state.lead.firm)}"></div>` +
            `</div>` +
            `<p class="dx-error" data-error hidden>Please add your name and a working email — the read-out needs someone to be addressed to.</p>` +
            `<button type="button" class="dx-primary" data-next>See my read-out &rarr;</button>`;
          shell(steps, inner, { back: true });
          // Mirror typed values into state as they change, so going Back and
          // returning (which rebuilds the DOM) never loses what was typed.
          (
            [
              ['dx-lead-name', 'name'],
              ['dx-lead-email', 'email'],
              ['dx-lead-firm', 'firm'],
            ] as const
          ).forEach(([id, key]) => {
            el!.querySelector<HTMLInputElement>(`#${id}`)?.addEventListener('input', (e) => {
              state.lead[key] = (e.target as HTMLInputElement).value;
            });
          });
          return;
        }

        if (step === 'readout') {
          renderReadout(steps);
          return;
        }

        // Branch-specific question step, e.g. "legal:pain" or "deal:dealType".
        const [dom, key] = step.split(':');
        const domain = data.domains[dom];
        const question = (domain as any)[key] as Question;
        const ans = state.answers[dom] || {};
        const inner =
          `<p class="dx-eyebrow">${esc(domain.label)}</p>` +
          `<h3 class="dx-q" tabindex="-1">${esc(question.q)}</h3>` +
          optionGrid(
            question.options,
            (o) => `data-choose data-kind="answer" data-target="${dom}:${key}" data-value="${esc(o.label)}"`,
            (o) => ans[key] === o.label
          );
        shell(steps, inner, { back: true });
      }

      function tierTag(tier: number) {
        const t = data.tiers[String(tier)];
        return `<span class="dx-tier dx-tier--${tier}">Tier ${tier} — ${esc(t.label)}</span>`;
      }

      function renderReadout(steps: string[]) {
        const { ranked, picked } = score();
        const items = ranked.map((s) => data.itemsBySlug[s]).filter(Boolean);
        const recurring = (state.frequency || '').startsWith('It comes up');
        const firstName = state.lead.name.trim().split(/\s+/)[0] || '';

        // 1. What we heard
        const heard = picked.length
          ? `<ul class="dx-heard">${picked
              .map(
                (p) =>
                  `<li><span class="dx-heard-dom">${esc(data.domains[p.domain].label)}:</span> “${esc(p.painLabel)}”</li>`
              )
              .join('')}</ul>`
          : `<p>You told us where your time goes — here’s the closest fit.</p>`;

        // 2. Current state (uses the shared role and tools answers if given)
        let roleBit = '';
        if (state.roleValue) {
          const v = state.roleValue.replace(/^[A-Z](?=[a-z])/, (c) => c.toLowerCase());
          roleBit = `You told us you’re ${esc(v)}. `;
        }
        const tq = toolsQuestion();
        const toolBits = tq
          ? state.tools
              .map((label) => tq.options.find((o) => o.label === label))
              .filter((o): o is Option => !!o && (o.value ?? '') !== '')
              .map((o) => o.value!)
          : [];
        const currentState = toolBits.length
          ? `<p>${roleBit}You mentioned you’re working with ${esc(toolBits.join(', '))}. Most people in your position are still doing the work below largely by hand — which is exactly where these fit.</p>`
          : `<p>${roleBit}Most people in your position are still doing the work below largely by hand.</p>`;

        // 3. Where Solborne fits
        const top = items.slice(0, 6);
        const fits = `<ul class="dx-fits">${top
          .map(
            (it) =>
              `<li><a href="/services/${it.slug}/"><span class="dx-fit-name">${esc(it.name)} <span aria-hidden="true">&rarr;</span></span><span class="dx-fit-cat">${esc(it.category)}</span></a><span class="dx-fit-blurb">${esc(it.blurb)}</span></li>`
          )
          .join('')}</ul>`;

        // 4. What this could be worth — up to 3 benchmarks, tier-labelled
        const worth = top
          .slice(0, 3)
          .map(
            (it) =>
              `<div class="dx-bench"><p class="dx-bench-name">${esc(it.name)}</p><p class="dx-bench-claim">${esc(it.claim)}</p><p class="dx-bench-meta">${tierTag(it.tier)} <span class="dx-bench-src">${esc(it.source)}</span></p></div>`
          )
          .join('');

        const freqNote = recurring
          ? 'You said this comes up regularly, so read any per-instance figure as something that recurs — the value compounds with volume.'
          : 'You said this is a one-time need, so read these as per-instance figures, not annualized.';

        el!.innerHTML =
          progress(steps) +
          `<div class="dx-card dx-readout">
            <p class="dx-eyebrow">Your read-out</p>
            <h3 class="dx-q" tabindex="-1">Here’s what we heard${firstName ? `, ${esc(firstName)}` : ''} — and where we’d fit.</h3>

            <div class="dx-block"><h4>Here’s what we heard</h4>${heard}</div>
            <div class="dx-block"><h4>Your current state</h4>${currentState}</div>
            <div class="dx-block"><h4>Where Solborne fits</h4>${fits}
              <p class="dx-more">These are the closest matches. The full catalog of ${Object.keys(data.itemsBySlug).length} workflows is <a href="/services/">available here</a>.</p>
            </div>
            <div class="dx-block"><h4>What this could be worth</h4>
              ${worth}
              <p class="dx-disclaimer">${esc(freqNote)} These are published industry benchmarks on comparable work — not a guarantee of your specific result — and each is tagged with how solid the underlying number actually is.</p>
            </div>

            <div class="dx-cta">
              ${
                state.leadId
                  ? `<a class="dx-primary dx-primary--link" href="/book/?lead=${esc(state.leadId)}">Book the discovery call &rarr;</a>
                     <a class="dx-alt" href="/contact/">Or write to us &rarr;</a>`
                  : `<a class="dx-primary dx-primary--link" href="/contact/">Get a human-reviewed version &rarr;</a>`
              }
              <button type="button" class="dx-restart" data-restart>Start over</button>
            </div>
            ${
              state.leadSaveFailed
                ? `<p class="dx-disclaimer">We couldn’t reach our server to save this read-out, so booking isn’t available from here — your read-out still stands, and the contact page works.</p>`
                : ''
            }
          </div>` +
          `<div class="dx-nav"><button type="button" class="dx-back" data-back>&larr; Back</button></div>`;

        el!.querySelector('[data-back]')?.addEventListener('click', () => go(-1));
        el!.querySelector('[data-restart]')?.addEventListener('click', () => {
          state.path = null; state.domains = []; state.answers = {};
          state.role = null; state.roleValue = null; state.tools = [];
          state.frequency = null; state.scale = null;
          state.leadId = null; state.leadSaveFailed = false;
          stepIndex = 0; render();
        });
        el!.querySelector<HTMLElement>('.dx-q')?.focus();
      }

      render();
    }
  </script>
</BaseLayout>

<style is:global>
  /* The diagnostic's markup is built at runtime via innerHTML, so it never
     carries Astro's scoped-style attribute — a scoped <style> here would
     match nothing and the whole flow would render unstyled. This block is
     deliberately global; every selector is namespaced under .dx- to keep it
     from leaking. */

  .dx {
    max-width: 46rem;
  }

  .dx-noscript {
    color: var(--color-body-strong);
  }

  /* ---- Progress ---- */
  .dx-count {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: 0.5rem;
  }

  .dx-count strong {
    font-weight: var(--weight-mono-medium);
    color: var(--color-steel);
  }

  .dx-progress {
    height: 3px;
    background: var(--color-track);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: var(--space-lg);
  }

  .dx-progress span {
    display: block;
    height: 100%;
    background: var(--color-steel);
    transition: width var(--duration-base) var(--ease-out);
  }

  /* ---- Card ---- */
  .dx-card {
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 1rem + 3vw, 2.5rem);
  }

  .dx-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono-medium);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: var(--space-sm);
  }

  .dx-q {
    font-size: var(--text-h3);
    line-height: var(--leading-heading);
    color: var(--color-ink);
    margin-bottom: var(--space-md);
    outline: none;
  }

  .dx-hint {
    font-size: var(--text-body-sm);
    color: var(--color-body);
    margin-bottom: var(--space-sm);
  }

  /* ---- Options ---- */
  .dx-options {
    display: grid;
    gap: 0.625rem;
  }

  .dx-options--wide {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .dx-option {
    text-align: left;
    background: var(--color-paper);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 0.875rem 1.125rem;
    font-size: var(--text-body-sm);
    color: var(--color-body-strong);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .dx-option:hover {
    border-color: var(--color-steel);
  }

  /* Selected state: Ink border on a warm neutral tint. Deliberately NOT the
     Bearing-amber wash — amber is one accent per view and never a button
     surface, and a multi-select can show several selected options at once. */
  .dx-option.is-selected {
    border-color: var(--color-ink);
    background: var(--color-track);
  }

  .dx-option--block {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem 1.25rem 1.375rem;
  }

  .dx-option-title {
    font-family: var(--font-display);
    font-weight: var(--weight-body-medium);
    font-size: var(--text-lede);
    color: var(--color-ink);
  }

  .dx-option-sub {
    font-size: var(--text-body-sm);
    color: var(--color-body);
  }

  /* ---- Lead-capture fields ---- */
  .dx-fields {
    display: grid;
    gap: var(--space-sm);
    max-width: 26rem;
  }

  .dx-field label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono-medium);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: 0.375rem;
  }

  .dx-optional {
    text-transform: none;
    letter-spacing: normal;
  }

  .dx-field input {
    width: 100%;
    background: var(--color-paper);
    border: var(--border-hairline);
    border-radius: var(--radius-swatch);
    padding: 0.75rem 1rem;
    /* 16px minimum: anything smaller triggers iOS Safari's focus zoom. */
    font-size: 1rem;
    color: var(--color-ink);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .dx-field input:focus {
    border-color: var(--color-steel);
  }

  .dx-error {
    font-size: var(--text-caption);
    color: var(--color-negative);
    margin-top: var(--space-sm);
  }

  /* ---- Buttons / nav ---- */
  .dx-primary {
    margin-top: var(--space-md);
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--weight-mono-medium);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 0.875rem 1.75rem;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .dx-primary:hover:not(:disabled) {
    background: var(--color-steel);
    border-color: var(--color-steel);
  }

  .dx-primary:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .dx-nav {
    margin-top: var(--space-md);
    min-height: 1.5rem;
  }

  .dx-back,
  .dx-restart {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    padding: 0.375rem 0;
  }

  .dx-back:hover,
  .dx-restart:hover {
    color: var(--color-ink);
  }

  /* Quiet secondary link beside the booking CTA. */
  .dx-alt {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-steel);
  }

  .dx-alt:hover {
    color: var(--color-ink);
  }

  /* ---- Read-out ---- */
  .dx-readout .dx-block {
    border-top: var(--border-hairline);
    padding-top: var(--space-md);
    margin-top: var(--space-md);
  }

  .dx-block h4 {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--weight-mono-medium);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: var(--space-sm);
  }

  .dx-block p {
    font-size: var(--text-body-sm);
    line-height: var(--leading-body);
    color: var(--color-body-strong);
  }

  .dx-heard {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .dx-heard li {
    font-size: var(--text-body-sm);
    color: var(--color-body-strong);
  }

  .dx-heard-dom {
    color: var(--color-stone);
  }

  .dx-fits {
    list-style: none;
    display: grid;
    gap: 0.875rem;
  }

  .dx-fits li {
    padding-bottom: 0.875rem;
    border-bottom: var(--border-hairline);
  }

  .dx-fits a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    text-decoration: none;
  }

  .dx-fit-name {
    font-weight: var(--weight-body-medium);
    color: var(--color-ink);
    font-size: var(--text-body);
  }

  .dx-fits a:hover .dx-fit-name {
    color: var(--color-steel);
  }

  .dx-fit-cat {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    white-space: nowrap;
  }

