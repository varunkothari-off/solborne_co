---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Section from '../../components/Section.astro';
import { walk } from '../../data/walk';

/**
 * Members dashboard. The minute a member lands:
 *  1. their walk is claimed (from the ?walk=/localStorage handoff),
 *  2. every spoken answer is shown, editable,
 *  3. below it, the preliminary report builds live (status + elapsed time —
 *     never the internal workings), then renders when ready,
 *  4. the journey map shows where they are and what comes after,
 *  5. once the package is paid, the AI screening call runs live in the
 *     browser (ElevenLabs WebRTC) — started whenever they're ready.
 */
const pageTitle = 'Your dashboard — Solborne & Co.';
const pageDescription =
  'Your walk, your preliminary report as it is built, and your screening call.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro eyebrow="Members" title="Here's where you stand.">
    <p>
      Everything you told us, the read we're building from it, and the next
      step — in one place.
    </p>
  </PageIntro>

  <Section label="Your walk">
    <div class="db" data-dashboard>
      <p class="db-loading" data-loading>Checking your session…</p>

      <div data-content hidden>
        <!-- Journey map -->
        <div class="db-journey" data-journey></div>

        <!-- Answers (editable) -->
        <div class="db-card">
          <h3 class="db-h">What you told us</h3>
          <p class="db-quiet">Word for word, as transcribed. Click any answer to correct it —
          the report is built from what stands here.</p>
          <div data-answers></div>
        </div>

        <!-- Report -->
        <div class="db-card" data-report-card>
          <h3 class="db-h">Your preliminary read</h3>
          <div data-report></div>
        </div>

        <!-- Screening package: the paywall. Free ends at the preliminary
             read; one payment unlocks the AI screening calls, expert
             screening calls, and the final audit report. -->
        <div class="db-card" data-screening-card>
          <h3 class="db-h">The screening call</h3>

          <div data-paywall hidden>
            <p class="db-quiet">Your walk and preliminary read were free. Everything from
            here is covered by one payment — the screening package:</p>
            <ul class="db-pkg-list" role="list">
              <li>AI screening calls — 30 minutes max, as deep as the walk was wide</li>
              <li>Expert screening calls — book our panel experts after the first screening</li>
              <li>The final audit report — verified by industry experts before it reaches you</li>
            </ul>
            <p class="db-pkg-price" data-pkg-price></p>
            <div class="db-row">
              <button type="button" class="db-primary" data-unlock>Unlock the package &rarr;</button>
              <button type="button" class="db-primary" data-pkg-simulate hidden>
                Simulate successful payment (stub)
              </button>
            </div>
            <p class="db-quiet db-pkg-note" data-pkg-note hidden></p>
          </div>

          <div data-scheduler hidden>
            <p class="db-quiet">Your package is active. A 30-minute-max live call with our
            AI agent, right here in the browser — it goes deeper than the walk, and a
            human reviews everything after. Start whenever you're ready.</p>
            <div data-screenings></div>
            <div data-call-idle>
              <div class="db-row">
                <button type="button" class="db-primary" data-start-call>Start the call now &rarr;</button>
              </div>
              <p class="db-quiet db-call-hint">No phone needed — the call happens here.
              Your browser will ask for microphone access.</p>
            </div>
            <div class="db-call" data-call-live hidden></div>
          </div>

          <p class="db-quiet db-after">
            After the call: our reviewers go through it by hand. If more is needed, we come
            back to you — the AI agent for small gaps, a person when it matters. After the
            first screening you can always book one of our panel experts directly. Once the
            relevant industry experts have verified the work, you get the final audit — and,
            if you want us to build it, we work as your consultants on a retainer: fixed
            yearly, monthly, weekly, or hourly, your preference.
          </p>
        </div>

        <p class="db-signout"><button type="button" class="db-ghost" data-signout>Sign out</button></p>
      </div>
      <p class="db-error" data-error hidden></p>
    </div>
  </Section>

  <script>
    import { createClient } from '@supabase/supabase-js';
    import { Conversation } from '@elevenlabs/client';

    const root = document.querySelector<HTMLElement>('[data-dashboard]');
    if (root) {
      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );

      const esc = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      const errorEl = root.querySelector<HTMLElement>('[data-error]')!;
      const fail = (msg: string) => { errorEl.textContent = msg; errorEl.hidden = false; };
      const fmt = (secs: number) =>
        `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;

      let token = '';
      let walkId: string | null = null;
      let walkStatus = '';

      async function api(path: string, init?: RequestInit): Promise<any> {
        const res = await fetch(path, {
          ...init,
          headers: {
            'content-type': 'application/json',
            authorization: `Bearer ${token}`,
            ...(init?.headers ?? {}),
          },
        });
        const data = await res.json().catch(() => null);
        if (!res.ok) throw new Error((data && data.error) || `request failed (${res.status})`);
        return data;
      }

      // ---- Journey map ----
      const JOURNEY = [
        { key: 'walk', label: 'The walk' },
        { key: 'report', label: 'Preliminary read' },
        { key: 'screening', label: 'AI screening call' },
        { key: 'review', label: 'Human review' },
        { key: 'experts', label: 'Expert verification' },
        { key: 'audit', label: 'Final audit' },
        { key: 'build', label: 'Implementation & retainer' },
      ];
      function renderJourney(activeKey: string, doneKeys: string[]) {
        const box = root!.querySelector<HTMLElement>('[data-journey]')!;
        box.innerHTML =
          `<p class="db-journey-label">Where you are</p>` +
          `<ol class="db-steps" role="list">` +
          JOURNEY.map((s) => {
            const cls = doneKeys.includes(s.key)
              ? ' is-done'
              : s.key === activeKey
                ? ' is-active'
                : '';
            return `<li class="db-step${cls}"><span class="db-dot" aria-hidden="true"></span>${esc(s.label)}</li>`;
          }).join('') +
          `</ol>`;
      }

      // ---- Answers ----
      function renderAnswers(walkData: any) {
        const box = root!.querySelector<HTMLElement>('[data-answers]')!;
        const answers: any[] = walkData.answers ?? [];
        if (answers.length === 0) {
          box.innerHTML = `<p class="db-quiet">No walk found on this account yet — <a href="/walk/">take the walk</a>.</p>`;
          return;
        }
        box.innerHTML = answers
          .map((a) => {
            const text = a.edited_transcript ?? a.transcript;
            return `
              <div class="db-answer" data-answer-id="${esc(a.id)}">
                <p class="db-answer-q">${esc(a.question)}</p>
                <p class="db-answer-t" data-text tabindex="0" role="button"
                   aria-label="Edit this answer">${esc(text)}</p>
              </div>`;
          })
          .join('');
        box.querySelectorAll<HTMLElement>('[data-text]').forEach((el) => {
          const startEdit = () => {
            const wrap = el.closest<HTMLElement>('[data-answer-id]')!;
            const current = el.textContent ?? '';
            wrap.innerHTML =
              `<p class="db-answer-q">${wrap.querySelector('.db-answer-q')!.innerHTML}</p>` +
              `<textarea class="db-answer-edit" rows="4">${esc(current)}</textarea>` +
              `<div class="db-row"><button type="button" class="db-primary" data-save>Save</button>` +
              `<button type="button" class="db-ghost" data-cancel>Cancel</button></div>`;
            wrap.querySelector('[data-save]')?.addEventListener('click', async () => {
              const text = wrap.querySelector<HTMLTextAreaElement>('.db-answer-edit')!.value.trim();
              if (!text) return;
              try {
                await api(`/api/answers/${wrap.dataset.answerId}/edit`, {
                  method: 'POST',
                  body: JSON.stringify({ text }),
                });
                await load(); // re-render everything from the source of truth
              } catch (err) {
                fail(err instanceof Error ? err.message : 'Could not save the edit.');
              }
            });
            wrap.querySelector('[data-cancel]')?.addEventListener('click', () => load());
          };
          el.addEventListener('click', startEdit);
          el.addEventListener('keydown', (e) => {
            if ((e as KeyboardEvent).key === 'Enter') startEdit();
          });
        });
      }

      // ---- Report ----
      let pollHandle: ReturnType<typeof setTimeout> | null = null;
      let genTick: ReturnType<typeof setInterval> | null = null;

      function renderReportReady(report: any) {
        if (genTick) clearInterval(genTick);
        const box = root!.querySelector<HTMLElement>('[data-report]')!;
        const matches = (report.matches ?? [])
          .map(
            (m: any) =>
              `<li><a href="/services/${esc(m.slug)}/">${esc(m.name)} &rarr;</a><span>${esc(m.reason)}</span></li>`
          )
          .join('');
        const wireframes: any[] = report.wireframes ?? [];
        const wireframesHtml = wireframes.length
          ? `<div class="db-rsec"><h4>What it could look like</h4>` +
            (wireframes.some((w) => w.stub)
              ? `<p class="db-quiet">Illustrative placeholders — real generated screens appear once Stitch is connected.</p>`
              : `<p class="db-quiet">Illustrative screens for the recommended solution — a starting point, not a final design.</p>`) +
            `<div class="db-wireframes">` +
            wireframes
              .map(
                (w) =>
                  `<figure class="db-wf"><img src="${esc(w.url)}" alt="${esc(w.label)} — illustrative screen" loading="lazy" />` +
                  `<figcaption>${esc(w.label)}</figcaption></figure>`
              )
              .join('') +
            `</div></div>`
          : '';

        box.innerHTML =
          (report.stub
            ? `<p class="db-stubnote">Preview report</p>`
            : '') +
          `<p class="db-headline">${esc(report.headline ?? '')}</p>` +
          (report.sections ?? [])
            .map(
              (s: any) =>
                `<div class="db-rsec"><h4>${esc(s.title)}</h4><p>${esc(s.body)}</p></div>`
            )
            .join('') +
          (matches
            ? `<div class="db-rsec"><h4>Where this maps in our catalog</h4><ul class="db-matches" role="list">${matches}</ul></div>`
            : '') +
          wireframesHtml;
      }

      function renderReportGenerating(startedAt: string | null, avgSeconds: number | null) {
        const box = root!.querySelector<HTMLElement>('[data-report]')!;
        box.innerHTML =
          `<p class="db-gen"><span class="db-gen-dot" aria-hidden="true"></span>Building your read — from your words, and from what we find researching you.</p>` +
          `<p class="db-quiet" data-gen-elapsed></p>` +
          (avgSeconds
            ? `<p class="db-quiet">Reports usually take about ${fmt(avgSeconds)}.</p>`
            : `<p class="db-quiet">You're among the first — once enough reports have been built, we'll show the typical time here.</p>`);
        const elapsedEl = box.querySelector<HTMLElement>('[data-gen-elapsed]')!;
        const t0 = startedAt ? new Date(startedAt).getTime() : Date.now();
        if (genTick) clearInterval(genTick);
        genTick = setInterval(() => {
          elapsedEl.textContent = `Elapsed: ${fmt(Math.max(0, Math.floor((Date.now() - t0) / 1000)))}`;
        }, 1000);
      }

      async function pollReport() {
        if (!walkId) return;
        try {
          const s = await api(`/api/walks/${walkId}/report`);
          if (s.status === 'report_ready') {
            await load();
            return;
          }
          renderReportGenerating(s.report_started_at, s.average_generation_seconds);
          pollHandle = setTimeout(pollReport, 2500);
        } catch {
          pollHandle = setTimeout(pollReport, 5000);
        }
      }

      // ---- Screening package (the paywall) ----
      let packageActive = false;
      let pendingOrderId: string | null = null;

      async function refreshPackage(): Promise<void> {
        const pkg = await api('/api/packages').catch(() => ({ active: false, price: null }));
        packageActive = pkg.active === true;
        root!.querySelector<HTMLElement>('[data-paywall]')!.hidden = packageActive;
        root!.querySelector<HTMLElement>('[data-scheduler]')!.hidden = !packageActive;
        if (!packageActive && pkg.price) {
          root!.querySelector<HTMLElement>('[data-pkg-price]')!.textContent =
            `One payment — ${pkg.price.display}. No meter, no surprise line items.`;
        }
      }

      // Returning from Stripe Checkout (?package=success): the webhook is
      // async and can lag well past a few seconds, so poll for up to ~45s,
      // and ALSO re-check whenever the tab regains focus. The ?package=success
      // breadcrumb is kept until the package actually activates, so a plain
      // reload keeps recovering. On give-up we leave a clear, actionable note
      // rather than a frozen "confirming…".
      let confirmingReturn = false;

      async function confirmStripeReturn(): Promise<void> {
        if (new URLSearchParams(location.search).get('package') !== 'success') return;
        if (confirmingReturn) return;
        confirmingReturn = true;
        const note = root!.querySelector<HTMLElement>('[data-pkg-note]')!;
        for (let i = 0; i < 22 && !packageActive; i += 1) {
          note.textContent = 'Confirming your payment — this can take a moment…';
          note.hidden = false;
          await refreshPackage();
          if (packageActive) break;
          await new Promise((r) => setTimeout(r, 2000));
        }
        if (packageActive) {
          history.replaceState(null, '', location.pathname);
        } else {
          note.textContent =
            'Payment received — Stripe is still confirming it. This can take a minute; ' +
            'refresh the page and your package will be unlocked. If it persists, write to us from the contact page.';
          note.hidden = false;
        }
        confirmingReturn = false;
      }

      root.querySelector('[data-unlock]')?.addEventListener('click', async () => {
        errorEl.hidden = true;
        const btn = root!.querySelector<HTMLButtonElement>('[data-unlock]')!;
        btn.disabled = true;
        btn.textContent = 'Preparing…';
        try {
          const res = await api('/api/packages', { method: 'POST' });
          if (res.active) { await refreshPackage(); return; }
          pendingOrderId = res.order.order_id;
          const note = root!.querySelector<HTMLElement>('[data-pkg-note]')!;
          if (res.order.checkout_url) {
            // REAL MODE: hand off to Stripe-hosted Checkout. The webhook — not
            // this redirect — is what actually unlocks the package on return.
            window.location.href = res.order.checkout_url;
            return;
          } else if (res.order.stub) {
            note.textContent =
              `Order ${res.order.order_id} created for ${res.order.display} ` +
              '(stub — no real payment system is connected yet, and no money moves).';
            note.hidden = false;
            root!.querySelector<HTMLElement>('[data-pkg-simulate]')!.hidden = false;
          } else {
            note.textContent =
              'Payment could not be started — please try again, or write to us from the contact page.';
            note.hidden = false;
          }
        } catch (err) {
          fail(err instanceof Error ? err.message : 'Could not start the purchase.');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Unlock the package →';
        }
      });

      root.querySelector('[data-pkg-simulate]')?.addEventListener('click', async () => {
        errorEl.hidden = true;
        const btn = root!.querySelector<HTMLButtonElement>('[data-pkg-simulate]')!;
        btn.disabled = true;
        btn.textContent = 'Simulating…';
        try {
          const res = await fetch('/api/dev/simulate-payment', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ order_id: pendingOrderId }),
          });
          const data = await res.json();
          if (!res.ok || !data.simulated) throw new Error(data.error ?? 'simulation failed');
          await refreshPackage();
          await load();
        } catch (err) {
          fail(err instanceof Error ? err.message : 'Simulation failed.');
          btn.disabled = false;
          btn.textContent = 'Simulate successful payment (stub)';
        }
      });

      // ---- Screenings ----
      function renderScreenings(items: any[]) {
        const box = root!.querySelector<HTMLElement>('[data-screenings]')!;
        if (!items.length) { box.innerHTML = ''; return; }
        box.innerHTML =
          `<ul class="db-screenings" role="list">` +
          items
            .map((s) => {
              const when = new Date(s.created_at ?? s.scheduled_at).toLocaleString();
              const label =
                s.status === 'triggered'
                  ? `call started — ${when}`
                  : s.status === 'completed'
                    ? 'complete'
                    : s.status === 'cancelled'
                      ? 'did not connect'
                      : 'reserved';
              return `<li><span class="db-scr-status">${esc(s.status)}</span> ${esc(label)}</li>`;
            })
            .join('') +
          `</ul>`;
      }

      // ---- The live call (in-browser WebRTC session) ----
      // States: idle -> connecting -> live (speaking/listening) -> ended.
      // Stub mode (no ElevenLabs keys) shows a simulated session, no network.
      //
      // Lifecycle discipline (per the WebRTC review): every live session must
      // be *ended* — not merely dereferenced — on error, disconnect, or a new
      // start, or the mic stays hot and ElevenLabs keeps billing. A monotonic
      // `callGen` tags each start; any callback whose generation is stale
      // no-ops, and superseding a session always ends it. `session` is
      // captured in onConversationCreated so it exists before any onError can
      // fire (the SDK flushes queued setup events after the instance is made).
      type LiveSession = Awaited<ReturnType<typeof Conversation.startSession>>;
      let session: LiveSession | null = null;
      let sessionStub = false;
      let starting = false;
      let callGen = 0;
      let callTick: ReturnType<typeof setInterval> | null = null;
      let callT0 = 0;

      const idleBox = () => root!.querySelector<HTMLElement>('[data-call-idle]')!;
      const liveBox = () => root!.querySelector<HTMLElement>('[data-call-live]')!;

      function renderCall(
        phase: 'connecting' | 'live' | 'ended',
        mode: 'speaking' | 'listening' = 'listening'
      ) {
        idleBox().hidden = phase !== 'ended';
        liveBox().hidden = false;
        if (phase === 'connecting') {
          liveBox().innerHTML =
            `<p class="db-gen"><span class="db-gen-dot" aria-hidden="true"></span>Connecting you to the agent…</p>`;
          return;
        }
        if (phase === 'live') {
          liveBox().innerHTML =
            (sessionStub
              ? `<p class="db-stubnote">Simulated session (stub) — no real voice agent is connected yet, and nothing is recorded.</p>`
              : '') +
            `<p class="db-gen"><span class="db-gen-dot" aria-hidden="true"></span>` +
            `Live — the agent is <span data-call-mode>${esc(mode)}</span>.</p>` +
            `<p class="db-quiet" data-call-elapsed></p>` +
            `<div class="db-row"><button type="button" class="db-primary" data-end-call>End the call</button></div>`;
          liveBox()
            .querySelector('[data-end-call]')
            ?.addEventListener('click', () => endCall());
          if (callTick) clearInterval(callTick);
          callT0 = Date.now();
          const elapsedEl = liveBox().querySelector<HTMLElement>('[data-call-elapsed]')!;
          callTick = setInterval(() => {
            elapsedEl.textContent = `On the call: ${fmt(Math.floor((Date.now() - callT0) / 1000))}`;
          }, 1000);
          return;
        }
        // ended
        if (callTick) clearInterval(callTick);
        liveBox().innerHTML =
          `<p class="db-quiet">Call ended. Our reviewers take it from here — you'll see
          the outcome on this page. If you were cut off, start again any time.</p>`;
      }

      function resetToIdle() {
        if (callTick) clearInterval(callTick);
        sessionStub = false;
        idleBox().hidden = false;
        liveBox().hidden = true;
        liveBox().innerHTML = '';
      }

      // End and drop the current live session (releases the mic, stops
      // billing). Safe to call when there is none.
      async function stopSession() {
        const s = session;
        session = null;
        if (s) {
          try { await s.endSession(); } catch { /* already closed */ }
        }
      }

      // User pressed "End", or is signing out.
      async function endCall() {
        callGen += 1; // invalidate this session's callbacks
        await stopSession();
        renderCall('ended');
        api('/api/me/screenings')
          .then((mine) => renderScreenings(mine.screenings ?? []))
          .catch(() => {});
      }

      async function startCall() {
        if (starting || session) return; // never stack a second live session
        starting = true;
        errorEl.hidden = true;
        const myGen = ++callGen;
        const btn = root!.querySelector<HTMLButtonElement>('[data-start-call]')!;
        btn.disabled = true;
        renderCall('connecting');
        try {
          // Server-side: paid-package gate, session cap, token mint,
          // conversation_id stored — all before this response exists.
          const prep = await api('/api/screenings', {
            method: 'POST',
            body: JSON.stringify({ walk_id: walkId }),
          });
          if (myGen !== callGen) return; // superseded (e.g. signout) mid-await
          sessionStub = prep.stub === true;

          if (sessionStub) {
            // No real agent behind the token — show the simulated session.
            renderCall('live');
            return;
          }

          // Preflight the mic so a denied permission fails early and clearly,
          // then release it immediately — the SDK acquires its own track, and
          // leaving this one live would keep the browser's mic indicator on.
          let micStream: MediaStream;
          try {
            micStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          } catch {
            resetToIdle();
            fail('Microphone access is needed for the call — allow it in your browser and try again.');
            return;
          }
          micStream.getTracks().forEach((t) => t.stop());
          if (myGen !== callGen) return;

          const conv = await Conversation.startSession({
            conversationToken: prep.token,
            connectionType: 'webrtc',
            // Informational for the agent's greeting only — the server
            // correlates by conversation_id, never by these.
            dynamicVariables: {
              booking_id: prep.screening_id,
              lead_name: prep.lead_name ?? '',
            },
            // Capture the instance the moment it exists, before the SDK flushes
            // any queued setup event (an onError in that window must be able to
            // end a real session, not orphan it).
            onConversationCreated: (created) => {
              if (myGen !== callGen) {
                created.endSession().catch(() => {});
                return;
              }
              session = created;
            },
            onConnect: () => {
              if (myGen === callGen) renderCall('live');
            },
            onModeChange: ({ mode }) => {
              if (myGen !== callGen) return;
              const el = liveBox().querySelector<HTMLElement>('[data-call-mode]');
              if (el) el.textContent = mode === 'speaking' ? 'speaking' : 'listening';
            },
            onDisconnect: () => {
              if (myGen !== callGen) return;
              callGen += 1;
              session = null;
              renderCall('ended');
              api('/api/me/screenings')
                .then((mine) => renderScreenings(mine.screenings ?? []))
                .catch(() => {});
            },
            onError: (message) => {
              if (myGen !== callGen) return;
              callGen += 1; // supersede: no later callback for this session acts
              void stopSession(); // end it — mic released, billing stopped
              resetToIdle();
              fail(typeof message === 'string' && message ? message : 'The call hit a problem — try again.');
            },
          });
          // If we were superseded between onConversationCreated and here, make
          // sure the returned instance is torn down too.
          if (myGen !== callGen) conv.endSession().catch(() => {});
        } catch (err) {
          if (myGen === callGen) {
            callGen += 1;
            await stopSession();
            resetToIdle();
            fail(err instanceof Error ? err.message : 'Could not start the call.');
          }
        } finally {
          starting = false;
          btn.disabled = false;
        }
      }

      // ---- Load everything ----
      async function load() {
        errorEl.hidden = true;
        const { data } = await supabase.auth.getSession();
        if (!data.session) {
          location.href = '/login/';
          return;
        }
        token = data.session.access_token;

        // Claim the walk handed over from the walk/login pages.
        const pending =
          new URLSearchParams(location.search).get('walk') ||
          localStorage.getItem('solborne-walk-id');
        if (pending) {
          try {
            await api(`/api/walks/${pending}/claim`, { method: 'POST' });
            localStorage.removeItem('solborne-walk-id');
          } catch {
            /* stale/foreign id — ignore */
          }
        }

        const mine = await api('/api/me/walks');
        const walks: any[] = mine.walks ?? [];
        const current = walks[0] ?? null;

        root!.querySelector<HTMLElement>('[data-loading]')!.hidden = true;
        root!.querySelector<HTMLElement>('[data-content]')!.hidden = false;

        await refreshPackage();
        await confirmStripeReturn();
        const screenings = await api('/api/me/screenings').catch(() => ({ screenings: [] }));
        renderScreenings(screenings.screenings ?? []);
        // Only a session that actually connected counts as "screening done" on
        // the journey map — a 'cancelled' (mint failed) or 'scheduled'
        // (reserved) row must not mark the step complete.
        const hasScreening = (screenings.screenings ?? []).some(
          (s: any) => s.status === 'triggered' || s.status === 'completed'
        );

        if (!current) {
          renderJourney('walk', []);
          renderAnswers({ answers: [] });
          root!.querySelector<HTMLElement>('[data-report]')!.innerHTML =
            `<p class="db-quiet">Your read appears here once you've <a href="/walk/">taken the walk</a>.</p>`;
          return;
        }

        walkId = current.walk_id;
        walkStatus = current.status;
        renderAnswers(current);

        const done: string[] = ['walk'];
        let active = 'report';
        if (current.status === 'report_ready') {
          done.push('report');
          active = hasScreening ? 'review' : 'screening';
          if (hasScreening) done.push('screening');
          renderReportReady(current.report ?? {});
        } else if (current.status === 'report_generating') {
          renderReportGenerating(current.report_started_at, null);
          pollReport();
        } else if (current.status === 'submitted') {
          // Kick generation, then poll — the member just sees it building.
          renderReportGenerating(null, null);
          try {
            await api(`/api/walks/${walkId}/report`, { method: 'POST' });
          } catch { /* pollReport surfaces state either way */ }
          pollReport();
        } else {
          active = 'walk';
          root!.querySelector<HTMLElement>('[data-report]')!.innerHTML =
            `<p class="db-quiet">Finish <a href="/walk/">your walk</a> first — the read is built from it.</p>`;
        }
        renderJourney(active, done);
      }

      // ---- Wire buttons ----
      root.querySelector('[data-start-call]')?.addEventListener('click', () => startCall());
      root.querySelector('[data-signout]')?.addEventListener('click', async () => {
        if (pollHandle) clearTimeout(pollHandle);
        await endCall().catch(() => {});
        await supabase.auth.signOut();
        location.href = '/';
      });

      // Belt-and-braces recovery: if a member returned from Stripe before the
      // webhook landed, re-check the package whenever they refocus the tab.
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible' && token && !packageActive) {
          refreshPackage().catch(() => {});
        }
      });

      load().catch((err) => {
        root!.querySelector<HTMLElement>('[data-loading]')!.hidden = true;
        fail(err instanceof Error ? err.message : 'Could not load your dashboard.');
      });
    }
  </script>
</BaseLayout>

