---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Section from '../../components/Section.astro';
import { walk, walkParts, partOneQuestions, partThreeFields } from '../../data/walk';
import { voicePreviewMode } from '../../lib/stt';
import { isStageStub } from '../../lib/llm';

/**
 * The Walk — voice-first intake.
 * Part 1: five fixed questions, spoken. Part 2: generated "right questions",
 * spoken. Part 3: typed facts for research. Sticky progress + running timer
 * (starts at the first click, freezes at submit — computed server-side).
 * Rendered per-request so preview-mode (no STT / no LLM key yet) is honest.
 */
export const prerender = false;
const previewMode = voicePreviewMode() || isStageStub('questions');

const pageTitle = `${walk.name} — Solborne & Co.`;
const pageDescription =
  `${walk.name}: say it the way it actually is — out loud. We listen, work out ` +
  'the questions worth asking you, research you properly, and hand you an honest ' +
  'preliminary read on where AI fits your work.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro eyebrow="Start here" title="Where does it actually hurt?">
    <p>
      No forms, no menus — you talk, we listen. {partOneQuestions.length} plain
      questions to start, then the questions your answers earn, then a few typed
      facts so we can research you properly. Most people are done inside
      {walk.targetMinutes} minutes.
    </p>
  </PageIntro>

  <Section label={walk.name}>
    <div class="wk" data-walk>
      {
        previewMode && (
          <div class="wk-preview" role="note">
            <p class="wk-preview-label">Preview mode</p>
            <p>
              The flow is fully working, but voice transcription and the
              generated follow-up questions aren't connected to live services
              yet here — recordings get a placeholder transcript, switching on
              automatically once the keys are added. Report generation is a
              separate, later step, with its own status once you're a member.
            </p>
          </div>
        )
      }
      <noscript>
        <p class="wk-note">
          The walk needs JavaScript and a microphone. You can also
          <a href="/contact/">write to us directly</a> — a person reads it.
        </p>
      </noscript>

      <!-- Sticky progress: parts, question count, elapsed timer -->
      <div class="wk-progress" data-progress hidden>
        <div class="wk-parts" data-parts></div>
        <div class="wk-progress-meta">
          <span data-qcount></span>
          <span class="wk-timer" data-timer aria-label="Time elapsed">0:00</span>
        </div>
        <div class="wk-bar"><span data-bar style="width:0%"></span></div>
      </div>

      <div class="wk-card" data-stage></div>
      <p class="wk-error" data-error hidden></p>
    </div>
  </Section>

  <script
    type="application/json"
    id="wk-config"
    set:html={JSON.stringify({ walk, parts: walkParts, partOne: partOneQuestions, fields: partThreeFields })}
  ></script>

  <script>
    type Field = {
      key: string; label: string; required: boolean;
      type: string; placeholder?: string;
    };
    type Config = {
      walk: { name: string; cta: string; path: string; targetMinutes: number };
      parts: { key: string; label: string }[];
      partOne: string[];
      fields: Field[];
    };

    const root = document.querySelector<HTMLElement>('[data-walk]');
    const cfgEl = document.getElementById('wk-config');
    if (root && cfgEl) {
      const cfg: Config = JSON.parse(cfgEl.textContent || '{}');
      const stage = root.querySelector<HTMLElement>('[data-stage]')!;
      const errorEl = root.querySelector<HTMLElement>('[data-error]')!;
      const progressEl = root.querySelector<HTMLElement>('[data-progress]')!;

      const esc = (s: string) =>
        s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      const fail = (msg: string) => { errorEl.textContent = msg; errorEl.hidden = false; };
      const clearError = () => { errorEl.hidden = true; };

      const STORE_KEY = 'solborne-walk-id';

      const state = {
        walkId: null as string | null,
        startedAtMs: null as number | null,
        part: 'intro' as 'intro' | 'one' | 'two' | 'facts' | 'done',
        qIndex: 0,
        partTwo: [] as string[],
        answered: { one: new Set<number>(), two: new Set<number>() },
        transcripts: {} as Record<string, string>,
        lastResult: null as Record<string, unknown> | null,
      };

      // ---- Timer ----
      let timerHandle: ReturnType<typeof setInterval> | null = null;
      function fmt(totalSeconds: number): string {
        const m = Math.floor(totalSeconds / 60);
        const s = totalSeconds % 60;
        return `${m}:${String(s).padStart(2, '0')}`;
      }
      function startTimer() {
        const el = root!.querySelector<HTMLElement>('[data-timer]')!;
        if (timerHandle) clearInterval(timerHandle);
        timerHandle = setInterval(() => {
          if (!state.startedAtMs) return;
          el.textContent = fmt(Math.max(0, Math.floor((Date.now() - state.startedAtMs) / 1000)));
        }, 1000);
      }
      function freezeTimer(seconds: number) {
        if (timerHandle) clearInterval(timerHandle);
        root!.querySelector<HTMLElement>('[data-timer]')!.textContent = fmt(seconds);
      }

      // ---- Progress ----
      function questionsInPart(part: 'one' | 'two'): number {
        return part === 'one' ? cfg.partOne.length : state.partTwo.length;
      }
      function renderProgress() {
        progressEl.hidden = state.part === 'intro';
        if (progressEl.hidden) return;
        const partsBox = progressEl.querySelector<HTMLElement>('[data-parts]')!;
        const order = ['one', 'two', 'facts'];
        const activeIdx =
          state.part === 'done' ? 3 : order.indexOf(state.part);
        partsBox.innerHTML = cfg.parts
          .map((p, i) => {
            const stateClass =
              i < activeIdx ? ' is-done' : i === activeIdx ? ' is-active' : '';
            return `<span class="wk-part${stateClass}"><span class="wk-part-num">${i + 1}</span>${esc(p.label)}</span>`;
          })
          .join('');
        const qcount = progressEl.querySelector<HTMLElement>('[data-qcount]')!;
        const bar = progressEl.querySelector<HTMLElement>('[data-bar]')!;
        if (state.part === 'one' || state.part === 'two') {
          const total = questionsInPart(state.part);
          qcount.textContent = `Question ${Math.min(state.qIndex + 1, total)} of ${total}`;
        } else if (state.part === 'facts') {
          qcount.textContent = 'A few typed facts';
        } else {
          qcount.textContent = 'Done';
        }
        // Overall: part one 0-40%, two 40-80%, facts 80-95%, done 100%.
        let pct = 0;
        if (state.part === 'one') pct = (state.qIndex / Math.max(1, cfg.partOne.length)) * 40;
        else if (state.part === 'two') pct = 40 + (state.qIndex / Math.max(1, state.partTwo.length)) * 40;
        else if (state.part === 'facts') pct = 85;
        else if (state.part === 'done') pct = 100;
        bar.style.width = `${Math.round(pct)}%`;
      }

      // ---- Recorder ----
      let mediaStream: MediaStream | null = null;
      let recorder: MediaRecorder | null = null;
      let chunks: Blob[] = [];
      let recStartedAt = 0;
      let recTickHandle: ReturnType<typeof setInterval> | null = null;

      function pickMime(): string {
        const candidates = ['audio/webm;codecs=opus', 'audio/webm', 'audio/mp4'];
        for (const c of candidates) {
          if (typeof MediaRecorder !== 'undefined' && MediaRecorder.isTypeSupported(c)) return c;
        }
        return '';
      }

      async function ensureMic(): Promise<MediaStream> {
        if (mediaStream) return mediaStream;
        mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        return mediaStream;
      }

      function blobToBase64(blob: Blob): Promise<string> {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onerror = () => reject(reader.error);
          reader.onload = () => resolve(String(reader.result).split(',')[1] ?? '');
          reader.readAsDataURL(blob);
        });
      }

      // ---- API ----
      async function api(path: string, init?: RequestInit): Promise<any> {
        const res = await fetch(path, init);
        const data = await res.json().catch(() => null);
        if (!res.ok) throw new Error((data && data.error) || `request failed (${res.status})`);
        return data;
      }

      // ---- Stages ----
      function currentQuestion(): string {
        return state.part === 'one' ? cfg.partOne[state.qIndex] : state.partTwo[state.qIndex];
      }

      function showIntro() {
        state.part = 'intro';
        renderProgress();
        stage.innerHTML = `
          <h3 class="wk-q">Ready when you are.</h3>
          <p class="wk-copy">A timer starts the moment you begin — most people are done
          inside ${cfg.walk.targetMinutes} minutes, longer if you have more to say.</p>
          <p class="wk-copy wk-copy--quiet">You'll need a microphone. We record each answer,
          transcribe it word for word, and show you the transcript before you move on.</p>
          <button type="button" class="wk-primary" data-begin>Begin the walk &rarr;</button>`;
        stage.querySelector('[data-begin]')?.addEventListener('click', begin);
      }

      async function begin() {
        clearError();
        try {
          // Mic permission FIRST — no point starting the timer without it.
          await ensureMic();
        } catch {
          fail('We need microphone access for the walk — your browser blocked it. Allow the mic and try again, or write to us from the contact page.');
          return;
        }
        try {
          const created = await api('/api/walks', { method: 'POST' });
          state.walkId = created.walk_id;
          localStorage.setItem(STORE_KEY, String(state.walkId));
          const walkState = await api(`/api/walks/${state.walkId}`);
          state.startedAtMs = new Date(walkState.started_at).getTime();
          startTimer();
          state.part = 'one';
          state.qIndex = 0;
          showQuestion();
        } catch (err) {
          fail(err instanceof Error ? err.message : 'Could not start the walk.');
        }
      }

      async function resume(walkId: string) {
        try {
          const w = await api(`/api/walks/${walkId}`);
          if (w.status !== 'in_progress') {
            // Already submitted — send them onwards to membership.
            state.walkId = walkId;
            state.part = 'done';
            state.lastResult = null;
            showDone(null);
            return;
          }
          state.walkId = walkId;
          state.startedAtMs = new Date(w.started_at).getTime();
          state.partTwo = w.questions ?? [];
          for (const a of w.answers ?? []) {
            const section = a.section as 'one' | 'two';
            state.answered[section]?.add(a.index);
            state.transcripts[`${a.section}:${a.index}`] = a.transcript;
          }
          startTimer();
          // Position: first unanswered of part one, else part two, else facts.
          const nextOne = cfg.partOne.findIndex((_, i) => !state.answered.one.has(i));
          if (nextOne !== -1) {
            state.part = 'one'; state.qIndex = nextOne;
          } else if (state.partTwo.length === 0) {
            state.part = 'one'; // finished part one but questions not generated yet
            await toPartTwo();
            return;
          } else {
            const nextTwo = state.partTwo.findIndex((_, i) => !state.answered.two.has(i));
            if (nextTwo !== -1) { state.part = 'two'; state.qIndex = nextTwo; }
            else { state.part = 'facts'; showFacts(); return; }
          }
          showQuestion();
        } catch {
          localStorage.removeItem(STORE_KEY);
          showIntro();
        }
      }

      function showQuestion() {
        renderProgress();
        const q = currentQuestion();
        stage.innerHTML = `
          <p class="wk-eyebrow">${esc(state.part === 'one' ? cfg.parts[0].label : cfg.parts[1].label)}</p>
          <h3 class="wk-q">${esc(q)}</h3>
          <div class="wk-rec">
            <button type="button" class="wk-mic" data-rec aria-label="Start recording">
              <span class="wk-mic-dot" aria-hidden="true"></span>
            </button>
            <p class="wk-rec-state" data-rec-state>Tap to speak</p>
          </div>
          <div class="wk-transcript" data-transcript hidden>
            <p class="wk-transcript-label">What we heard</p>
            <p class="wk-transcript-text" data-transcript-text></p>
            <textarea class="wk-transcript-edit" data-transcript-edit hidden></textarea>
            <div class="wk-row" data-view-actions>
              <button type="button" class="wk-primary" data-accept>Sounds right &rarr;</button>
              <button type="button" class="wk-quiet" data-edit>Edit</button>
              <button type="button" class="wk-quiet" data-again>Say it again</button>
            </div>
            <div class="wk-row" data-edit-actions hidden>
              <button type="button" class="wk-primary" data-save-edit>Save &rarr;</button>
              <button type="button" class="wk-quiet" data-cancel-edit>Cancel</button>
            </div>
          </div>`;
        wireRecorder();
      }

      function wireRecorder() {
        const btn = stage.querySelector<HTMLButtonElement>('[data-rec]')!;
        const recState = stage.querySelector<HTMLElement>('[data-rec-state]')!;
        const transcriptBox = stage.querySelector<HTMLElement>('[data-transcript]')!;
        const transcriptText = stage.querySelector<HTMLElement>('[data-transcript-text]')!;
        const transcriptEdit = stage.querySelector<HTMLTextAreaElement>('[data-transcript-edit]')!;
        const viewActions = stage.querySelector<HTMLElement>('[data-view-actions]')!;
        const editActions = stage.querySelector<HTMLElement>('[data-edit-actions]')!;

        let recording = false;
        // While true, the mic button appends a transcribed clip to the edit
        // textarea instead of replacing the saved answer — see onRecorded().
        let editMode = false;

        btn.addEventListener('click', async () => {
          clearError();
          if (!recording) {
            try {
              const stream = await ensureMic();
              chunks = [];
              const mime = pickMime();
              recorder = new MediaRecorder(stream, mime ? { mimeType: mime } : undefined);
              recorder.ondataavailable = (e) => { if (e.data.size > 0) chunks.push(e.data); };
              recorder.onstop = onRecorded;
              recorder.start();
              recording = true;
              recStartedAt = Date.now();
              btn.classList.add('is-recording');
              btn.setAttribute('aria-label', 'Stop recording');
              recTickHandle = setInterval(() => {
                recState.textContent = `Recording… ${fmt(Math.floor((Date.now() - recStartedAt) / 1000))} — tap to stop`;
              }, 500);
              recState.textContent = 'Recording… tap to stop';
            } catch {
              fail('Could not start the microphone. Check the browser permission and try again.');
            }
          } else {
            recording = false;
            if (recTickHandle) clearInterval(recTickHandle);
            recorder?.stop();
            btn.classList.remove('is-recording');
            btn.setAttribute('aria-label', 'Start recording');
          }
        });

        async function onRecorded() {
          const blob = new Blob(chunks, { type: recorder?.mimeType || 'audio/webm' });
          if (Date.now() - recStartedAt < 1200 || blob.size < 1500) {
            recState.textContent = 'That was very short — tap and take your time.';
            return;
          }

          if (editMode) {
            recState.textContent = 'Transcribing…';
            try {
              const audioBase64 = await blobToBase64(blob);
              const { transcript } = await api(`/api/walks/${state.walkId}/answers`, {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({
                  section: state.part,
                  index: state.qIndex,
                  question: currentQuestion(),
                  audio_base64: audioBase64,
                  mime: blob.type,
                  transcribe_only: true,
                }),
              });
              const sep = transcriptEdit.value.trim() ? ' ' : '';
              transcriptEdit.value = `${transcriptEdit.value}${sep}${transcript}`;
              recState.textContent = 'Added — keep editing, add more, or save.';
            } catch (err) {
              recState.textContent = 'Tap the mic to add more by speaking.';
              fail(err instanceof Error ? err.message : 'Could not transcribe that — try again.');
            }
            return;
          }

          recState.textContent = 'Transcribing…';
          try {
            const audioBase64 = await blobToBase64(blob);
            const saved = await api(`/api/walks/${state.walkId}/answers`, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                section: state.part,
                index: state.qIndex,
                question: currentQuestion(),
                audio_base64: audioBase64,
                mime: blob.type,
              }),
            });
            state.transcripts[`${state.part}:${state.qIndex}`] = saved.transcript;
            state.answered[state.part as 'one' | 'two'].add(state.qIndex);
            transcriptText.textContent = saved.transcript;
            transcriptBox.hidden = false;
            recState.textContent = 'Not quite right? Edit it, or record over it.';
          } catch (err) {
            recState.textContent = 'Tap to speak';
            fail(err instanceof Error ? err.message : 'Could not save that answer — try again.');
          }
        }

        stage.querySelector('[data-accept]')?.addEventListener('click', advance);

        stage.querySelector('[data-again]')?.addEventListener('click', () => {
          transcriptBox.hidden = true;
          recState.textContent = 'Tap to speak';
        });

        stage.querySelector('[data-edit]')?.addEventListener('click', () => {
          editMode = true;
          transcriptEdit.value = transcriptText.textContent ?? '';
          transcriptText.hidden = true;
          transcriptEdit.hidden = false;
          viewActions.hidden = true;
          editActions.hidden = false;
          recState.textContent = 'Tap the mic to add more by speaking, or edit the text directly.';
          transcriptEdit.focus();
        });

        stage.querySelector('[data-cancel-edit]')?.addEventListener('click', () => {
          editMode = false;
          transcriptEdit.hidden = true;
          transcriptText.hidden = false;
          editActions.hidden = true;
          viewActions.hidden = false;
          recState.textContent = 'Not quite right? Edit it, or record over it.';
        });

        stage.querySelector('[data-save-edit]')?.addEventListener('click', async () => {
          const text = transcriptEdit.value.trim();
          if (!text) { fail('Write or say something before saving.'); return; }
          const saveBtn = stage.querySelector<HTMLButtonElement>('[data-save-edit]')!;
          saveBtn.disabled = true;
          try {
            const saved = await api(`/api/walks/${state.walkId}/answers`, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({
                section: state.part,
                index: state.qIndex,
                question: currentQuestion(),
                manual_transcript: text,
              }),
            });
            state.transcripts[`${state.part}:${state.qIndex}`] = saved.transcript;
            state.answered[state.part as 'one' | 'two'].add(state.qIndex);
            transcriptText.textContent = saved.transcript;
            editMode = false;
            transcriptEdit.hidden = true;
            transcriptText.hidden = false;
            editActions.hidden = true;
            viewActions.hidden = false;
            recState.textContent = 'Not quite right? Edit it, or record over it.';
          } catch (err) {
            fail(err instanceof Error ? err.message : 'Could not save your edit — try again.');
          } finally {
            saveBtn.disabled = false;
          }
        });
      }

      async function advance() {
        clearError();
        const total = questionsInPart(state.part as 'one' | 'two');
        if (state.qIndex + 1 < total) {
          state.qIndex += 1;
          showQuestion();
          return;
        }
        if (state.part === 'one') {
          await toPartTwo();
        } else {
          state.part = 'facts';
          state.qIndex = 0;
          showFacts();
        }
      }

      async function toPartTwo() {
        renderProgress();
        stage.innerHTML = `
          <p class="wk-eyebrow">${esc(cfg.parts[1].label)}</p>
          <h3 class="wk-q">Working out the questions worth asking you…</h3>
          <p class="wk-copy wk-copy--quiet">Everything you just said is being read. The next
          questions exist because of your answers — there may be three, there may be nine.</p>
          <p class="wk-gen" data-gen>Listening back…</p>`;
        const gen = stage.querySelector<HTMLElement>('[data-gen]')!;
        const t0 = Date.now();
        const tick = setInterval(() => {
          gen.textContent = `Listening back… ${fmt(Math.floor((Date.now() - t0) / 1000))}`;
        }, 1000);
        try {
          const data = await api(`/api/walks/${state.walkId}/questions`, { method: 'POST' });
          state.partTwo = data.questions ?? [];
          clearInterval(tick);
          if (state.partTwo.length === 0) throw new Error('no questions came back');
          state.part = 'two';
          state.qIndex = state.partTwo.findIndex((_, i) => !state.answered.two.has(i));
          if (state.qIndex === -1) { state.part = 'facts'; showFacts(); return; }
          showQuestion();
        } catch (err) {
          clearInterval(tick);
          fail(err instanceof Error ? err.message : 'Could not build your questions — try again.');
          stage.innerHTML += `<button type="button" class="wk-primary" data-retry>Try again</button>`;
          stage.querySelector('[data-retry]')?.addEventListener('click', toPartTwo, { once: true });
        }
      }

      function showFacts() {
        renderProgress();
        const inputs = cfg.fields
          .map((f) => {
            const req = f.required ? ' required' : '';
            const optional = f.required ? '' : ' <span class="wk-optional">(optional)</span>';
            const control =
              f.type === 'textarea'
                ? `<textarea id="wk-${f.key}" rows="2"${req}></textarea>`
                : `<input id="wk-${f.key}" type="${f.type}"${req} ${f.placeholder ? `placeholder="${esc(f.placeholder)}"` : ''}>`;
            return `<div class="wk-field"><label for="wk-${f.key}">${esc(f.label)}${optional}</label>${control}</div>`;
          })
          .join('');
        stage.innerHTML = `
          <p class="wk-eyebrow">${esc(cfg.parts[2].label)}</p>
          <h3 class="wk-q">Now the facts — so we can research you properly.</h3>
          <p class="wk-copy wk-copy--quiet">We use these to look you up the way a careful
          analyst would: your site, your market, your competition, your customers. Skip
          anything you like — the more you give, the sharper the read. Only your name and
          email are required.</p>
          <div class="wk-fields">${inputs}</div>
          <button type="button" class="wk-primary" data-finish>Finish the walk &rarr;</button>`;
        stage.querySelector('[data-finish]')?.addEventListener('click', submitFacts);
      }

      async function submitFacts() {
        clearError();
        const contact: Record<string, string> = {};
        for (const f of cfg.fields) {
          const el = stage.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#wk-${f.key}`);
          const value = el?.value.trim() ?? '';
          if (value) contact[f.key] = value;
          if (f.required && !value) {
            fail(`${f.label} is required.`);
            el?.focus();
            return;
          }
        }
        const emailEl = stage.querySelector<HTMLInputElement>('#wk-email');
        if (emailEl && !emailEl.checkValidity()) {
          fail('That email does not look right.');
          emailEl.focus();
          return;
        }
        const btn = stage.querySelector<HTMLButtonElement>('[data-finish]')!;
        btn.disabled = true;
        btn.textContent = 'Finishing…';
        try {
          const result = await api(`/api/walks/${state.walkId}/submit`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(contact),
          });
          state.part = 'done';
          state.lastResult = result;
          showDone(result);
        } catch (err) {
          btn.disabled = false;
          btn.textContent = 'Finish the walk →';
          fail(err instanceof Error ? err.message : 'Could not submit — try again.');
        }
      }

      function showDone(result: Record<string, unknown> | null) {
        renderProgress();
        const dur = result ? Number(result.duration_seconds) : null;
        if (dur) freezeTimer(dur);
        const avg = result ? (result.average_duration_seconds as number | null) : null;
        const timeLine = dur
          ? avg
            ? `You took <strong>${fmt(dur)}</strong>. People usually take about <strong>${fmt(avg)}</strong>.`
            : `You took <strong>${fmt(dur)}</strong>. You're among the first to walk — once enough people have, we'll show the typical time here.`
          : 'This walk is already submitted.';
        stage.innerHTML = `
          <p class="wk-eyebrow">Done</p>
          <h3 class="wk-q">That's the walk.</h3>
          <p class="wk-copy">${timeLine}</p>
          <p class="wk-copy">Your answers are in. Next: become a member — free — and watch
          your preliminary read being built from what you said and what we find researching
          you. Then, if it earns it, the screening call.</p>
          <a class="wk-primary" href="/login/?walk=${esc(String(state.walkId))}">Become a member — free &rarr;</a>`;
      }

      // ---- Boot ----
      if (typeof MediaRecorder === 'undefined') {
        stage.innerHTML = `<h3 class="wk-q">Your browser can't record audio.</h3>
          <p class="wk-copy">The walk is voice-first and needs microphone recording.
          Try a current Chrome, Edge, Safari or Firefox — or
          <a href="/contact/">write to us directly</a>.</p>`;
      } else {
        const stored = localStorage.getItem(STORE_KEY);
        if (stored) resume(stored);
        else showIntro();
      }
    }
  </script>
</BaseLayout>

