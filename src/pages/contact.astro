---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';
import { services } from '../data/services';

const pageTitle = 'Contact — Solborne & Co.';
const pageDescription =
  "Tell us where you are with AI and we'll give you an honest first read. If we're not the right fit, we'll say so and point you somewhere better.";
const notSureOption = 'Not sure yet — just talking';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageIntro eyebrow="Contact" title="Tell us where you are.">
    <p>
      What you're weighing, what you've tried, what you're unsure about — we'll give you
      an honest first read: what looks worth your attention, and what doesn't.
    </p>
    <p>If we're not the right fit, we'll say so and point you somewhere better.</p>
  </PageIntro>

  <Section label="Write to us">
    <div class="contact-grid">
      <div class="form-col">
        <!-- ============================================================
             FORM BACKEND INTEGRATION POINT (not wired yet — intentional)
             This form is front-end only. To wire it up, either:
               1. Point the form's action at a form service or your own
                  endpoint and remove the placeholder submit handler below.
               2. Keep the client-side handler and POST the FormData to
                  your endpoint via fetch.
             The placeholder <script> at the bottom of this file currently
             intercepts submit and shows the fallback notice instead of
             sending anything. Delete it when the real endpoint exists.
             ============================================================ -->

        <!-- No-JS fallback — without JavaScript the placeholder handler never
             runs, and the form has no action, so a submit would GET this same
             page and silently drop the message. Show a notice and hide the
             submit button instead. Delete alongside the placeholder script
             once a real endpoint exists. -->
        <noscript>
          <div class="noscript-notice">
            <p class="notice-label mono">JavaScript is off</p>
            <p>
              This form needs JavaScript and isn't connected to anything yet, so it can't
              send your message. Please email us directly at
              <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>
              — a human will read it and reply.
            </p>
          </div>
          <style is:inline>
            /* Hide the submit button so no-JS visitors can't post into the void. */
            #contact-form .submit {
              display: none;
            }
            /* Minimal duplicate of the scoped .form-notice look — Astro's
               scoped styles don't reliably reach inside <noscript>, so the
               same tokens are restated here. */
            .noscript-notice {
              margin-bottom: var(--space-md);
              background: var(--color-panel);
              border: var(--border-hairline);
              border-radius: var(--radius-card);
              padding: 1.25rem 1.5rem;
            }
            .noscript-notice .notice-label {
              font-size: var(--text-tag);
              letter-spacing: var(--tracking-tag);
              text-transform: uppercase;
              color: var(--color-stone);
              margin-bottom: var(--space-2xs);
            }
            .noscript-notice p:not(.notice-label) {
              font-size: var(--text-body-sm);
              line-height: var(--leading-tight);
              color: var(--color-body);
            }
            .noscript-notice .email-link {
              font-family: var(--font-mono);
              font-weight: var(--weight-mono);
              color: var(--color-steel);
              overflow-wrap: anywhere;
            }
          </style>
        </noscript>

        <form id="contact-form" aria-label="Contact form">
          <div class="field">
            <label for="contact-name">Name</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
            />
          </div>

          <div class="field">
            <label for="contact-email">Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </div>

          <div class="field">
            <label for="contact-firm">
              Firm / organization <span class="optional">(optional)</span>
            </label>
            <input
              id="contact-firm"
              name="firm"
              type="text"
              autocomplete="organization"
            />
          </div>

          <div class="field">
            <label for="contact-need">What do you need?</label>
            <select id="contact-need" name="need">
              {services.map((service) => <option value={service.name}>{service.name}</option>)}
              <option value={notSureOption} selected>{notSureOption}</option>
            </select>
          </div>

          <div class="field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="6" required></textarea>
          </div>

          <p class="reply-note mono">We aim to reply within two business days.</p>

          <button class="submit" type="submit">Send message</button>
        </form>

        <!-- Fallback notice — revealed by the placeholder script below when
             someone submits the not-yet-wired form. Hidden by default. The
             script moves focus here on reveal, which announces the notice to
             assistive tech — no live region needed. -->
        <div id="form-notice" class="form-notice" tabindex="-1" hidden>
          <p class="notice-label mono">Not connected yet</p>
          <p>
            This form isn't wired to anything yet, so your message wasn't sent. Please email
            us directly at <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>
            — a human will read it and reply.
          </p>
        </div>
      </div>

      <aside class="sidebar" aria-label="Other ways to reach us">
        <article class="side-card">
          <h2>Prefer email?</h2>
          <p>
            Skip the form entirely. Write to us at
            <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a> — it lands in
            the same place, and a person reads it either way.
          </p>
        </article>

        <article class="side-card">
          <h2>What happens next</h2>
          <ol class="next-list" role="list">
            <li>We read your note. A person does, not a pipeline.</li>
            <li>A human replies — no automated pitch sequence.</li>
            <li>
              If your problem belongs to someone else, we tell you plainly and suggest where
              to take it.
            </li>
          </ol>
        </article>

        <p class="side-note">
          Not sure what to ask for? The <a href="/services/">free diagnostic</a> is the usual
          starting point — eight plain questions, no call attached.
        </p>
      </aside>
    </div>
  </Section>

  <!-- PLACEHOLDER SCRIPT — delete this whole block once the form posts to a
       real endpoint. See the FORM BACKEND INTEGRATION POINT comment above the
       <form> tag. All it does is stop the submit and reveal the fallback
       notice; nothing is sent anywhere. -->
  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      var notice = document.getElementById('form-notice');
      if (!form || !notice) return;
      form.addEventListener('submit', function (event) {
        // Placeholder: the form has no backend yet, so never actually submit.
        event.preventDefault();
        notice.hidden = false;
        notice.focus();
      });
    })();
  </script>
</BaseLayout>

<style>
  /* ---- Two-column layout: form (wider) + sidebar ---- */
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  /* ---- Form ---- */
  .field {
    margin-bottom: var(--space-md);
  }

  .field label {
    display: block;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-body-medium);
    color: var(--color-body-strong);
    margin-bottom: var(--space-2xs);
  }

  .optional {
    font-size: var(--text-caption);
    font-weight: var(--weight-body);
    color: var(--color-stone);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 0.8125rem 1rem;
    font-family: var(--font-body);
    font-weight: var(--weight-body);
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--color-ink);
  }

  .field textarea {
    resize: vertical;
  }

  .reply-note {
    font-size: var(--text-caption);
    color: var(--color-stone);
    margin-bottom: var(--space-md);
  }

  /* Submit button — mirrors the solid Button component (which renders an
     <a>, so its look is replicated here for a real <button type="submit">).
     Same tokens: mono uppercase pill, Ink fill, Steel hover. */
  .submit {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--weight-mono-medium);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    padding: 0.875rem 1.75rem;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1px solid var(--color-ink);
    text-align: center;
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .submit:hover {
    background: var(--color-steel);
    border-color: var(--color-steel);
  }

  /* ---- Fallback notice (hidden until the placeholder script reveals it) ---- */
  .form-notice {
    margin-top: var(--space-md);
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
  }

  .form-notice[hidden] {
    display: none;
  }

  .notice-label {
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: var(--space-2xs);
  }

  .form-notice p:not(.notice-label) {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  /* ---- Sidebar ---- */
  .sidebar {
    display: grid;
    gap: var(--space-md);
  }

  .side-card {
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.625rem;
  }

  .side-card h2 {
    font-size: var(--text-h3);
    line-height: var(--leading-heading);
    margin-bottom: var(--space-xs);
  }

  .side-card p {
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  .email-link {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    color: var(--color-steel);
    overflow-wrap: anywhere;
  }

  .next-list {
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: var(--space-xs);
  }

  .next-list li {
    counter-increment: step;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xs);
    font-size: var(--text-body-sm);
    line-height: var(--leading-tight);
    color: var(--color-body);
  }

  .next-list li::before {
    content: counter(step, decimal-leading-zero) / '';
    font-family: var(--font-mono);
    font-weight: var(--weight-mono);
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-tag);
    color: var(--color-steel);
    padding-top: 0.3em;
  }

  .side-note {
    font-size: var(--text-caption);
    line-height: var(--leading-tight);
    color: var(--color-stone);
    padding-inline: 0.25rem;
  }

  /* ---- Collapse to a single column ---- */
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
    }
  }
</style>
