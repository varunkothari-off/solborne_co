---
/**
 * The brand's signature "confidence gets a number" element: a question, a
 * plain answer with a mono confidence numeral, and a level Steel bar.
 * From the design file's "Confidence gets a number" panel.
 */
interface Props {
  question: string;
  answer: string;
  /** 0–100 */
  confidence: number;
  note?: string;
}

const { question, answer, confidence, note } = Astro.props;
---

<figure class="conf">
  <p class="q">{question}</p>
  <p class="a">
    {answer}
    <span class="num">Confidence: {confidence}%.</span>
    {note && <span>{note}</span>}
  </p>
  <div
    class="bar"
    role="img"
    aria-label={`Confidence level: ${confidence} percent`}
  >
    <i style={`width:${confidence}%;`}></i>
  </div>
</figure>

<style>
  .conf {
    margin: 0;
    background: var(--color-panel);
    border: var(--border-hairline);
    border-radius: var(--radius-card);
    padding: 1.375rem 1.5rem;
  }

  .q {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: var(--weight-display);
    margin-bottom: 0.875rem;
    color: var(--color-ink);
  }

  .a {
    font-size: 0.90625rem;
    line-height: 1.6;
    color: var(--color-body);
  }

  .num {
    font-family: var(--font-mono);
    font-weight: var(--weight-mono-medium);
    color: var(--color-steel);
  }

  .bar {
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-track);
    margin-top: 0.875rem;
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    background: var(--color-steel);
    border-radius: var(--radius-pill);
  }
</style>
