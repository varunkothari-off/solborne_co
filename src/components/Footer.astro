---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
import { roadmap } from '../data/roadmap';
import { walk } from '../data/walk';

const year = new Date().getFullYear();

/** Footer sitemap. Case studies stay out while site.showCaseStudies is false. */
const companyLinks = [
  { href: '/about/', label: 'About' },
  { href: '/approach/', label: 'Approach' },
  ...(site.showCaseStudies ? [{ href: '/case-studies/', label: 'Case Studies' }] : []),
  { href: '/contact/', label: 'Contact' },
];

const startLinks = [
  { href: walk.path, label: walk.cta },
  { href: '/services/', label: 'How It Flows' },
  { href: '/dashboard/', label: 'Members' },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="lockup" aria-hidden="true">
      <Mark size={54} label="" />
    </div>
    <p class="wm"><Wordmark /></p>
    <p class="tagline">{site.tagline}</p>

    <nav class="sitemap" aria-label="Sitemap">
      <div class="sitemap-col">
        <p class="sitemap-label">Start here</p>
        <ul role="list">
          {startLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
        <p class="sitemap-label sitemap-label--stacked">Company</p>
        <ul role="list">
          {companyLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="sitemap-col sitemap-col--services">
        <p class="sitemap-label">Services</p>
        {/* One labeled list; it flows into two visual columns on desktop. */}
        <ul role="list" class="sitemap-services">
          {
            roadmap.map((category) => (
              <li>
                <a href={`/services/${category.slug}/`}>{category.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <p class="legal">
      &copy; {year} Solborne &amp; Co. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-hairline);
    margin-top: var(--space-2xl);
    padding: 4.375rem 0 6rem;
    text-align: center;
    color: var(--color-ink);
  }

  .lockup {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-md);
  }

  .wm {
    font-size: 1.625rem;
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-footer);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-top: 1.125rem;
  }

  /* ---- Sitemap ---- */
  .sitemap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-lg) var(--space-xl);
    max-width: 46rem;
    margin: var(--space-2xl) auto 0;
    text-align: left;
  }

  .sitemap-label {
    font-family: var(--font-mono);
    font-size: var(--text-tag);
    font-weight: var(--weight-mono-medium);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    color: var(--color-stone);
    margin-bottom: 0.875rem;
    padding-bottom: 0.5rem;
    border-bottom: var(--border-hairline);
  }

  .sitemap-label--stacked {
    margin-top: var(--space-md);
  }

  .sitemap ul {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  /* The ten category links flow across two columns under the one label. */
  .sitemap-services {
    display: block;
    columns: 2;
    column-gap: var(--space-xl);
  }

  .sitemap-services li {
    break-inside: avoid;
    margin-bottom: 0.5rem;
  }

  .sitemap a {
    font-size: var(--text-body-sm);
    text-decoration: none;
    color: var(--color-body);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .sitemap a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 760px) {
    .sitemap {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .sitemap-services {
      columns: 1;
    }
  }

  .legal {
    margin-top: var(--space-2xl);
    font-size: var(--text-caption);
    color: var(--color-stone);
  }
</style>
