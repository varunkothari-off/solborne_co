---
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';

const navItems = [
  { href: '/services/', label: 'Services' },
  { href: '/approach/', label: 'Approach' },
  { href: '/case-studies/', label: 'Case Studies' },
  { href: '/about/', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
const ariaCurrent = (href: string): 'page' | 'true' | undefined => {
  if (currentPath === href) return 'page';
  if (href !== '/' && currentPath.startsWith(href)) return 'true';
  return undefined;
};
---

<header class="site-header">
  <div class="wrap bar">
    <a class="lockup" href="/" aria-label="Solborne & Co. — home">
      <Mark size={34} label="" />
      <Wordmark />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul role="list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={ariaCurrent(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="contact-cta"
            href="/contact/"
            aria-current={ariaCurrent('/contact/')}
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--border-hairline);
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(6px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
  }

  .lockup {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--color-ink);
    text-decoration: none;
    font-size: 1.375rem;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    list-style: none;
  }

  .site-nav a {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    font-weight: var(--weight-mono);
    letter-spacing: var(--tracking-tag);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-stone);
    padding-block: 0.375rem;
    /* the "level horizon" underline, hidden until active/hover */
    border-bottom: 2px solid transparent;
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .site-nav a:hover {
    color: var(--color-ink);
  }

  .site-nav a[aria-current] {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .site-nav .contact-cta {
    color: var(--color-paper);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 0.625rem 1.25rem;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .site-nav .contact-cta:hover,
  .site-nav .contact-cta[aria-current] {
    background: var(--color-steel);
    border-color: var(--color-steel);
    color: var(--color-paper);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.625rem;
    cursor: pointer;
    flex-direction: column;
    gap: 6px;
  }

  .nav-toggle-bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-ink);
    transition: transform var(--duration-base) var(--ease-out);
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-paper);
      border-bottom: var(--border-hairline);
    }

    .site-nav.open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-sm) var(--gutter) var(--space-md);
    }

    .site-nav a {
      display: block;
      padding: var(--space-xs) 0;
      border-bottom: none;
    }

    .site-nav a[aria-current] {
      border-bottom: none;
      color: var(--color-ink);
    }

    .site-nav .contact-cta {
      display: inline-block;
      margin-top: var(--space-sm);
      text-align: center;
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-bar:first-child {
      transform: translateY(4px) rotate(45deg);
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle-bar:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }
  }

  /* Mirrors global.css .wrap: narrow gutter below 760px. */
  @media (max-width: 760px) {
    .site-nav ul {
      padding-inline: var(--gutter-narrow);
    }
  }
</style>

<script>
  // Minimal, dependency-free mobile nav toggle.
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
</script>
