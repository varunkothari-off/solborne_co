---
/**
 * Masthead pattern from the design file: centered mono eyebrow (optional),
 * serif headline, measured intro paragraph, thin level rule beneath.
 *
 * Headlines built from two statements pass `lines` instead of `title`: each
 * statement renders as its own balanced line, so the break always lands on
 * the sentence boundary and the two lines sit cleanly under one another.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  /** Two-statement headlines: one entry per line. Takes precedence over title. */
  lines?: string[];
}

const { eyebrow, title, lines } = Astro.props;
---

<header class="page-intro">
  <div class="wrap">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>
      {lines ? lines.map((line) => <span class="line">{line}</span>) : title}
    </h1>
    <div class="intro"><slot /></div>
    <div class="rule-thin" aria-hidden="true"></div>
  </div>
</header>

<style>
  .page-intro {
    padding: clamp(3.5rem, 2rem + 6vw, var(--space-3xl)) 0 3.75rem;
    text-align: center;
  }

  .eyebrow {
    margin-bottom: 1.875rem;
  }

  h1 {
    margin-bottom: 1.375rem;
    text-wrap: balance;
  }

  /* One statement per line, each wrapping in balance with the other. */
  .line {
    display: block;
    text-wrap: balance;
  }

  .intro {
    max-width: var(--width-intro);
    margin: 0 auto;
    font-size: var(--text-body-lg);
    line-height: var(--leading-intro);
    color: var(--color-body);
  }

  .intro :global(p + p) {
    margin-top: var(--space-sm);
  }

  /* The level horizon, in miniature. Stays level; never decorated. */
  .rule-thin {
    width: 60px;
    height: 1px;
    background: var(--color-ink);
    opacity: 0.45;
    margin: 2.375rem auto 0;
  }
</style>
